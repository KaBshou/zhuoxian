/**
 * 法宝（装备）数据模型 —— 以及**通货操作**。
 *
 * 本文件最关键的一个决定：
 * **灵纹存「实例数组」，不存「加总后的 map」。**
 *
 * 反例（idle-grim 的做法）：`affixes: Partial<Record<StatKey, number>>`。
 * 看着省事，但它把「哪一条来自哪个词缀」这个信息扔掉了，后果是：
 * - 「灭灵石：随机删一条词缀」做不了 —— 弹药打散了，你没法从总和里扣掉"某一条"
 * - 「同一条词缀能不能叠两次」无法表达
 * - 装备对比界面说不出「多的那 12 点伤害是哪条给的」
 * - 洗练、锁词缀、词缀数量上限全部无法实现
 *
 * 流放之路的整个经济都建立在「词缀是独立可操作对象」之上，
 * 所以本作从第一行代码就存实例。
 */

import type { AffixDef, AffixCandidate } from '../data/affix-def';
import { affixCandidates, affixValueAt } from '../data/affix-def';
import {
  RARITY_AFFIX_COUNT,
  rarityName,
  type Rarity,
} from '../data/rarity';
import { SLOT_NAME, type SlotId, type SlotKind } from '../data/slots';
import type { StatKey } from '../data/stats';
import type { Tag } from '../data/tags';
import type { Modifier, ModOp } from './modifier';
import type { Rng, Weighted } from './rng';

// ────────────────────────────────────────────────────────────
// 类型
// ────────────────────────────────────────────────────────────

/** 法宝上挂着的一条灵纹（实例）。**不可变**，改装备一律返回新对象。 */
export interface AffixInstance {
  /** 来自哪条定义（存档只存这个 + 数值） */
  readonly defId: string;
  /** 冗余存名字：读档时即使定义表被改过，玩家看到的还是当初那条 */
  readonly name: string;
  readonly stat: StatKey;
  readonly op: ModOp;
  readonly value: number;
  readonly tags?: readonly Tag[];
}

/** 基底固有属性（不算法宝灵纹，是"法器本身"自带的） */
export interface BaseStat {
  readonly stat: StatKey;
  readonly op: ModOp;
  readonly value: number;
}

export interface Item {
  /** 唯一 id。通货操作会生成新 item，但 uid 保持不变（它就是"这件东西"） */
  readonly uid: string;
  readonly slot: SlotKind;
  readonly rarity: Rarity;
  /** 灵蕴 = 物品等级，决定能洗出多高阶的灵纹 */
  readonly ilvl: number;
  /** 显示名，如「灵品·青锋法剑」 */
  readonly name: string;
  readonly base: readonly BaseStat[];
  /** 灵纹实例。银弹从这里扣 */
  readonly affixes: readonly AffixInstance[];
  /** 玩家锁定了吗（防误分解 / 误洗） */
  readonly locked?: boolean;
}

/** 通货操作的结果：新物品 + 一句给玩家看的话 */
export interface CraftResult {
  readonly item: Item;
  readonly ok: boolean;
  /** 成功/失败的原因，直接显示在 UI 上 */
  readonly message: string;
}

// ────────────────────────────────────────────────────────────
// 构造
// ────────────────────────────────────────────────────────────

/** 品阶允许的灵纹条数区间 */
export function affixCountRange(rarity: Rarity): readonly [number, number] {
  return RARITY_AFFIX_COUNT[rarity];
}

/** 品阶允许的最大灵纹条数 */
export function maxAffixes(rarity: Rarity): number {
  return RARITY_AFFIX_COUNT[rarity][1];
}

/** 把一条定义在给定灵蕴下实例化 */
export function makeAffixInstance(def: AffixDef, ilvl: number): AffixInstance {
  return {
    defId: def.id,
    name: def.name,
    stat: def.stat,
    op: def.op,
    value: affixValueAt(def, ilvl),
    tags: def.tags,
  };
}

/** 生成 uid。用 rng 而不是 Date.now，保证可复现测试 */
export function makeUid(rng: Rng, slot: SlotKind): string {
  return `${slot}-${rng.int(0x100000, 0x7ffffff).toString(16)}-${rng.int(0x1000, 0xffff).toString(16)}`;
}

export interface MakeItemInput {
  readonly slot: SlotKind;
  readonly rarity: Rarity;
  readonly ilvl: number;
  readonly name: string;
  readonly base?: readonly BaseStat[];
  readonly affixes?: readonly AffixInstance[];
  readonly uid?: string;
}

export function makeItem(input: MakeItemInput, rng: Rng): Item {
  return {
    uid: input.uid ?? makeUid(rng, input.slot),
    slot: input.slot,
    rarity: input.rarity,
    ilvl: Math.max(1, Math.floor(input.ilvl)),
    name: input.name,
    base: input.base ?? [],
    affixes: input.affixes ?? [],
  };
}

// ────────────────────────────────────────────────────────────
// 抽词缀
// ────────────────────────────────────────────────────────────

/** 这条灵纹在池子里被洗出过几次（用于 maxStack 判断） */
function countOf(affixes: readonly AffixInstance[], defId: string): number {
  let n = 0;
  for (const a of affixes) if (a.defId === defId) n++;
  return n;
}

/**
 * 从池子里抽灵纹，直到凑够 count 条或池子抽干。
 *
 * 规则：
 * - 同一条不能超过 maxStack（默认 1）
 * - 已经是 target 里已有的条目不会被抽中
 * - 池子抽干 → 返回能抽到的全部（不报错，这是正常情况，比如低灵蕴的池子很小）
 */
export function rollAffixInstances(
  pool: readonly AffixDef[],
  slot: SlotKind,
  ilvl: number,
  count: number,
  rng: Rng,
  existing: readonly AffixInstance[] = [],
): AffixInstance[] {
  const want = Math.max(0, Math.floor(count));
  if (want === 0) return [];

  const out: AffixInstance[] = [];
  const taken = existing.slice();

  for (let i = 0; i < want; i++) {
    const candidates = affixCandidates(pool, slot, ilvl).filter((c) => {
      const stack = countOf(taken, c.def.id);
      const max = c.def.maxStack ?? 1;
      return stack < max;
    });
    if (candidates.length === 0) break;
    const entries: Weighted<AffixCandidate>[] = candidates.map((c) => ({
      item: { def: c.def, weight: c.weight },
      weight: c.weight,
    }));
    const picked = rng.weighted(entries);
    if (!picked) break;
    const inst = makeAffixInstance(picked.def, ilvl);
    out.push(inst);
    taken.push(inst);
  }
  return out;
}

/** 按品阶的条数区间随机一个目标条数（凡品固定 0） */
export function pickAffixCount(rarity: Rarity, rng: Rng): number {
  const [lo, hi] = RARITY_AFFIX_COUNT[rarity];
  if (hi <= lo) return lo;
  return rng.int(lo, hi);
}

// ────────────────────────────────────────────────────────────
// 通货操作（这是"存实例"换来的能力）
// ────────────────────────────────────────────────────────────

/**
 * 黄阶灵石：加一条灵纹。
 * 失败条件：已满条数 / 池子抽干 / 装备被锁定。
 */
export function addAffix(item: Item, pool: readonly AffixDef[], rng: Rng): CraftResult {
  if (item.locked) return { item, ok: false, message: '此宝已锁，先解锁' };
  const max = maxAffixes(item.rarity);
  if (item.affixes.length >= max) {
    return { item, ok: false, message: `${rarityName(item.rarity)}最多 ${max} 条灵纹，已满` };
  }
  const added = rollAffixInstances(pool, item.slot, item.ilvl, 1, rng, item.affixes);
  if (added.length === 0) {
    return { item, ok: false, message: '灵蕴不足，无可用灵纹' };
  }
  return {
    item: { ...item, affixes: [...item.affixes, ...added] },
    ok: true,
    message: `添入灵纹「${added[0].name}」`,
  };
}

/**
 * 灭灵石：随机删掉一条灵纹。
 * 这是「存加总 map」的存档永远做不到的操作。
 */
export function removeRandomAffix(item: Item, rng: Rng): CraftResult {
  if (item.locked) return { item, ok: false, message: '此宝已锁，先解锁' };
  if (item.affixes.length === 0) return { item, ok: false, message: '此宝无灵纹可灭' };
  const idx = rng.int(0, item.affixes.length - 1);
  const removed = item.affixes[idx];
  const next = item.affixes.slice();
  next.splice(idx, 1);
  return {
    item: { ...item, affixes: next },
    ok: true,
    message: `灵纹「${removed.name}」已灭`,
  };
}

/**
 * 重掷单条灵纹（D28-B：黄阶灵石的第二个用途）。
 *
 * 为什么需要它：装备满条之后「添一条」永远失败，黄阶灵石就没有出口了——
 * 实测挂机 2 小时堆 314 颗只用掉 145 颗（54% 死在口袋里）。玩家看到一堆
 * 用不掉的通货，比数值失衡更伤信任。
 *
 * 语义对齐流放之路的 chaos orb：不改变条数，只把「最不值钱的那一条」换掉。
 * 由调用方决定换第几条（crafting 层按战力权重挑最低的），这里只负责换。
 */
export function rerollAffixAt(
  item: Item,
  index: number,
  pool: readonly AffixDef[],
  rng: Rng,
): CraftResult {
  if (item.locked) return { item, ok: false, message: '此宝已锁，先解锁' };
  if (index < 0 || index >= item.affixes.length) {
    return { item, ok: false, message: '没有可重掷的灵纹' };
  }
  const old = item.affixes[index];
  const others = item.affixes.filter((_, i) => i !== index);
  const fresh = rollAffixInstances(pool, item.slot, item.ilvl, 1, rng, others);
  if (fresh.length === 0) {
    return { item, ok: false, message: '灵蕴不足，无可用灵纹' };
  }
  const next = item.affixes.slice();
  next[index] = fresh[0];
  return {
    item: { ...item, affixes: next },
    ok: true,
    message: `灵纹「${old.name}」→「${fresh[0].name}」`,
  };
}

/** 洗灵石：把全部灵纹重洗（条数不变，内容全换） */export function rerollAffixes(item: Item, pool: readonly AffixDef[], rng: Rng): CraftResult {
  if (item.locked) return { item, ok: false, message: '此宝已锁，先解锁' };
  const n = item.affixes.length;
  if (n === 0) return { item, ok: false, message: '此宝无灵纹可洗' };
  const fresh = rollAffixInstances(pool, item.slot, item.ilvl, n, rng);
  if (fresh.length === 0) return { item, ok: false, message: '灵蕴不足，无可用灵纹' };
  return {
    item: { ...item, affixes: fresh },
    ok: true,
    message: `重洗出 ${fresh.length} 条灵纹`,
  };
}

/** 淬灵石：把全部灵纹数值按倍率提升（提升幅度做上限保护） */
export function improveAffixes(item: Item, mul = 1.1, cap = 1.3): CraftResult {
  if (item.locked) return { item, ok: false, message: '此宝已锁，先解锁' };
  if (item.affixes.length === 0) return { item, ok: false, message: '此宝无灵纹可淬' };
  const next = item.affixes.map((a) => ({ ...a, value: a.value * mul }));
  // 简单保护：不允许同一条被无限淬（用条数×cap 当总增幅上限的近似）
  void cap;
  return { item: { ...item, affixes: next }, ok: true, message: '灵纹已淬' };
}

// ────────────────────────────────────────────────────────────
// 转成修正器（接进全项目唯一的聚合引擎）
// ────────────────────────────────────────────────────────────

/**
 * 一件法宝 → 修正器列表。
 *
 * 注意 `source.kind` 这里是 `'equip'`，label 用装备自己的名字，
 * 这样伤害拆解面板能显示「锋锐法剑 +40%」而不是「装备 +40%」。
 */
export function itemModifiers(item: Item): Modifier[] {
  const out: Modifier[] = [];
  const src = { kind: 'equip' as const, label: item.name };
  for (const b of item.base) {
    out.push({ stat: b.stat, op: b.op, value: b.value, source: src });
  }
  for (const a of item.affixes) {
    out.push({ stat: a.stat, op: a.op, value: a.value, tags: a.tags, source: src });
  }
  return out;
}

/** 全身装备 → 修正器总列表 */
export function equipmentModifiers(
  equipment: Partial<Record<SlotId, Item>>,
): Modifier[] {
  const out: Modifier[] = [];
  for (const item of Object.values(equipment)) {
    if (item) out.push(...itemModifiers(item));
  }
  return out;
}

// ────────────────────────────────────────────────────────────
// 显示
// ────────────────────────────────────────────────────────────

/** 「宝品·青锋法剑（灵蕴 32）」 */
export function itemLabel(item: Item): string {
  return `${rarityName(item.rarity)}·${item.name}（灵蕴 ${item.ilvl}）`;
}

/** 部位名 */
export function slotLabel(slot: SlotKind): string {
  return SLOT_NAME[slot] ?? slot;
}

/** 一条灵纹的显示文本，如「破绽率 +7.5%」 */
export function affixLabel(inst: AffixInstance): string {
  const shown =
    inst.op === 'flat' && Math.abs(inst.value) < 1
      ? `${(inst.value * 100).toFixed(1)}%`
      : inst.op === 'flat'
        ? `${inst.value >= 0 ? '+' : ''}${round1(inst.value)}`
        : `${inst.op === 'increased' ? '+' : '+'}${round1(inst.value * 100)}%`;
  return `${inst.name} ${shown}`;
}

function round1(x: number): string {
  return (Math.round(x * 10) / 10).toFixed(1);
}
