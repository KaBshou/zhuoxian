/**
 * 渊痕的三个花法（D36-A E1，BALANCE §21.10）。
 *
 * 铁律（抄自 data/marks.ts，改之前先读那里）：
 * - **不产生战力。** 三档全是「省时间 / 换材料 / 定向重铸」，没有一条给伤害或气血。
 * - 只有三档，不许加战斗属性档。
 *
 * 为什么需要这个文件：渊痕只是数字时，玩家满级后看着它涨却不知道能干什么 ——
 * 那和没有这个系统一样。花钱的动作必须存在，而且必须在 core 里（不能只在 UI 里）。
 */
import type { GameSession } from './session';
import { setFloor, highestFloorReached, pushLog } from './session';
import { MARKS_COST, MARK_SINK_NAME, type MarkSink } from '../data/marks';
import { improveAffixes } from './item';
import { itemPower as itemPowerOf } from './inventory';
import { equippedItems } from './character';
import type { Item } from './item';

export interface SpendResult {
  readonly ok: boolean;
  /** 失败原因（中文，可直接给玩家看） */
  readonly reason?: string;
  /** 成功时的产出描述（同样直接给玩家看） */
  readonly message: string;
}

function marksOf(s: GameSession): number {
  const v = s.character.marks ?? 0;
  return Number.isFinite(v) ? Math.max(0, Math.floor(v)) : 0;
}

function costOf(sink: MarkSink): number {
  const v = MARKS_COST[sink];
  return Number.isFinite(v) ? Math.max(0, Math.floor(v)) : Infinity;
}

/**
 * 花渊痕。成功时**原地改 s**（marks 扣掉、效果生效），返回给玩家看的文案。
 *
 * 注意：这里故意用「原地改」而不是返回新 session —— 它和 setFloor / craft 一样
 * 是"玩家做了一个动作"，不是"每帧推进"。批量推进的东西才用纯函数。
 */
export function spendMarks(s: GameSession, sink: MarkSink): SpendResult {
  const have = marksOf(s);
  const cost = costOf(sink);
  if (!Number.isFinite(cost)) {
    return { ok: false, reason: '这一档没有定价', message: '' };
  }
  if (have < cost) {
    return {
      ok: false,
      reason: `渊痕不足：需要 ${cost.toLocaleString('en-US')}，现有 ${have.toLocaleString('en-US')}`,
      message: '',
    };
  }

  switch (sink) {
    case 'rerollCurrency': {
      // 一块洗灵石 = 22.7 分钟的量。刻意做成「买材料」而不是「买装备」：
      // 装备必须从地上掉，否则段②的 6.9h 装备成型会变成挂机攒钱。
      s.pocket.xi += 1;
      const msg = `聚灵：倾入 ${cost.toLocaleString('en-US')} 渊痕，得洗灵石 ×1`;
      pushLog(s, msg, '#6b3fa0');
      break;
    }
    case 'divineReforge': {
      // 夺造化 = 把「最强且还没淬满」的那件法宝的灵纹一次拔到淬炼上限（1.3×原值）。
      //
      // 为什么不是「重掷最弱一条再拔高」：ceshi 实测那条路径的净收益 ≈ 0（+0.63% / −0.55% / 0 …）
      // —— 重掷会把一条已成型的灵纹换成随机新灵纹，涨的和掉的抵掉了，玩家花 150 万渊痕
      // 却看不出变化，等于花钱买了个空。改成「确定拔到上限」后每次购买都有可感知收益，
      // 且因为每件灵纹上限 = 1.3×原值，**这条线会自己耗尽**（9 件穿满即无货可买），
      // 不会变成无限战力口子（D45）。
      const target = pickUpgradable(s);
      if (!target) {
        const any = pickBestEquipped(s);
        return {
          ok: false,
          reason: any
            ? '身上所有法宝的灵纹都已至淬炼极限（每件最多 +30%）'
            : '身上没有法宝，夺造化无处下手',
          message: '',
        };
      }
      const up = improveAffixes(target.item, 1.3, 1.3);
      if (!up.ok) {
        return { ok: false, reason: up.message, message: '' };
      }
      s.character.equipment[target.key] = up.item;
      const msg = `夺造化：${up.item.name} 的灵纹被拔至淬炼极限`;
      pushLog(s, msg, '#d4a13c');
      break;
    }
    case 'setStartFloor': {
      // 定渊 = 立刻把人送到「到过的最深层」。它不产生战力，只省掉重新下潜的时间。
      const target = highestFloorReached(s);
      if (target <= s.floor) {
        return { ok: false, reason: `已经在最深处（第 ${s.floor} 层）`, message: '' };
      }
      const moved = setFloor(s, target);
      if (!moved) {
        return { ok: false, reason: '这一层还下不去', message: '' };
      }
      const msg = `定渊：踏渊而下，直落第 ${target} 层`;
      pushLog(s, msg, '#4fd1c5');
      break;
    }
    default: {
      return { ok: false, reason: '未知的渊痕花法：' + String(sink), message: '' };
    }
  }

  // 扣费放最后：上面的分支里任何一条提前 return 都不该扣钱
  const after = have - cost;
  (s.character as { marks?: number }).marks = after;
  return { ok: true, message: MARK_SINK_NAME[sink] };
}

/** 身上战力最高的那件法宝（同战力取第一个，保证可复现） */
function pickBestEquipped(s: GameSession): Item | null {
  let best: Item | null = null;
  let bestPower = -Infinity;
  for (const e of equippedItems(s.character)) {
    const p = itemPowerOf(e.item);
    if (p > bestPower) {
      bestPower = p;
      best = e.item;
    }
  }
  return best;
}

/** 在装备槽里找到这件法宝挂在哪一格（divineReforge 要写回去） */
function slotKeyOf(s: GameSession, uid: string): keyof GameSession['character']['equipment'] {
  for (const [key, item] of Object.entries(s.character.equipment)) {
    if (item && item.uid === uid) {
      return key as keyof GameSession['character']['equipment'];
    }
  }
  return 'sword';
}

/** 淬炼上限（与 `improveAffixes` 的默认 cap 同源，改一处要改两处） */
const REFORGE_CAP = 1.3;

/** 这件法宝是否已经淬满（每一条灵纹都到了 baseValue × cap） */
function affixesAtCap(item: Item): boolean {
  if (item.affixes.length === 0) return true; // 没有灵纹 = 无可淬
  return item.affixes.every((a) => {
    const base = a.baseValue ?? a.value;
    return a.value >= base * REFORGE_CAP - 1e-9;
  });
}

/** 战力最高的「还有灵纹没淬满」的那件（同战力取第一个，保证可复现） */
function pickUpgradable(
  s: GameSession,
): { item: Item; key: keyof GameSession['character']['equipment'] } | null {
  let best: Item | null = null;
  let bestKey: keyof GameSession['character']['equipment'] = 'sword';
  let bestPower = -Infinity;
  for (const e of equippedItems(s.character)) {
    if (affixesAtCap(e.item)) continue;
    const p = itemPowerOf(e.item);
    if (p > bestPower) {
      bestPower = p;
      best = e.item;
      bestKey = slotKeyOf(s, e.item.uid);
    }
  }
  return best ? { item: best, key: bestKey } : null;
}
