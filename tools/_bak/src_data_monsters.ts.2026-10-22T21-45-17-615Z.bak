export const ALL_MONSTERS: readonly MonsterDef[] = [...MONSTERS, ...BOSSES];

const BY_ID = new Map<string, MonsterDef>(ALL_MONSTERS.map((m) => [m.id, m]));

export function getMonster(id: string): MonsterDef | undefined {
  return BY_ID.get(id);
}

/** 某阶的普通怪列表 */
export function monstersOfTier(tier: 1 | 2 | 3): MonsterDef[] {
  return MONSTERS.filter((m) => m.tier === tier);
}

/** 某阶的镇守（一阶 1~9 层 / 二阶 10~18 / 三阶 19~27） */
export function bossOfTier(tier: 1 | 2 | 3): MonsterDef | undefined {
  return BOSSES.find((m) => m.tier === tier);
}

/**
 * 阶数 → 该阶第一层（一阶 = 1，二阶 = 10，三阶 = 19；27 层模型）。
 * 同阶内的 9 层用同一种怪，靠层曲线（×8.4 血）拉开强度。
 */
export function floorOfTier(tier: 1 | 2 | 3): number {
  // 27 层模型：三段各 9 层，该阶第一层是 1/10/19
  return (tier - 1) * 9 + 1;
}

/** 层数 → 阶数（1~9 一阶 / 10~18 二阶 / 19~27 三阶） */
export function tierOfFloor(floor: number): 1 | 2 | 3 {
  if (!Number.isFinite(floor)) return 1;
  const f = Math.max(1, Math.floor(floor));
  if (f <= 9) return 1;
  if (f <= 18) return 2;
  return 3;
}

/**
 * 第 `floor` 层的怪物血量/攻伐缩放系数（BALANCE §3 公式的实现）。
 * 无尽层（floor > 9）同样适用 —— 曲线不封顶，难度自然上升。
 */
/** 攻伐软上限（BALANCE v4.1 §17.5，D22）：层 20 之前按 1.09 全速涨，
 *  之后斜率降到 1.03。理由：玩家 EHP 在台阶 80 封顶（裸装 370），怪攻若按
 *  1.09^26 一路涨，层 27 镇守战内总入伤 = 26 发 × 3.81% = 99.1% 必死；
 *  软上限后层 27 攻伐 6.3236（−32.7%），镇守战 45%（余量 55%）。
 *  层 1~20 完全不变（分支不执行），深层表 C 的普通波判定也不受影响。 */
export const FLOOR_DAMAGE_SOFT_FLOOR = 20;
export const FLOOR_DAMAGE_SOFT_MUL = 1.03;

export function scaleOfFloor(floor: number): { hp: number; damage: number } {
  const f = Number.isFinite(floor) && floor >= 1 ? Math.floor(floor) : 1;
  const damage =
    f <= FLOOR_DAMAGE_SOFT_FLOOR
      ? Math.pow(FLOOR_DAMAGE_MUL, f - 1)
      : Math.pow(FLOOR_DAMAGE_MUL, FLOOR_DAMAGE_SOFT_FLOOR - 1) *
        Math.pow(FLOOR_DAMAGE_SOFT_MUL, f - FLOOR_DAMAGE_SOFT_FLOOR);
  // 层 1~27 主线：一位不差地保持 1.1534^(f-1)（改这里会让全部 27 层基线作废）
  const hp =
    f <= MAIN_FLOOR_END
      ? Math.pow(FLOOR_HP_MUL, f - 1)
      : Math.pow(FLOOR_HP_MUL, MAIN_FLOOR_END - 1) *
        Math.pow(ENDLESS_HP_GROWTH, f - MAIN_FLOOR_END);
  return { hp, damage };
}

/**
 * 第 floor 层的镇守血量系数（D36-A / E1）。
 *
 * 层 ≤27 恒为 BOSS_HP_MUL（25）；层 28 起每层 ×0.8 线性降幂，
 * 到 ENDLESS_BOSS_HP_MUL（10）为止：
 *   层 28 = 20（比层 27 低 14%，连续不跳崖）、29 = 16、30 = 12.8、31 = 10.24、
 *   层 32 起钉 10。配合 BOSS_EVERY_FLOORS=5，层 36 镇守 3 889×10 = 38 890 → 44s。
 */
export function bossHpMul(floor: number): number {
  if (!Number.isFinite(floor) || floor <= MAIN_FLOOR_END) return BOSS_HP_MUL;
  return Math.max(
    ENDLESS_BOSS_HP_MUL,
    BOSS_HP_MUL * Math.pow(0.8, floor - MAIN_FLOOR_END),
  );
}

/**
 * 分段威胁（D109）：层 22 起怪物伤害 ×8，镇守额外 ×1.5（合计 ×12）。
 *
 * 为什么必须分段而不是全局：
 *   - 层 1~21 是教学期。实测层 27 的致死倍率 K* ≈ 11（还要挨 100 多下才死），
 *     新手期 K 大一点没错，那里不该被打死；
 *   - 层 22+ 是玩家已经拿齐装备与回复词条的地方，只有在那里「气血/护甲/抗性」才有意义；
 *   - 全局抬会同时打破 §16 的 EHP 验收和 §6 的满级时长（30min 级别的连锁）。
 *
 * 为什么是「伤害」而不是「血量」：抬血量只会让 TTK 变长（更多点击/更久挂机），
 * 抬伤害才让 EHP 重新变成一种资源。两者对满级时长都有影响，但只有伤害能修「防御无意义」。
 *
 * 硬验收：12 种子满级中位涨幅 ≤3%（超了降到 ×5）。
 */
export const DEEP_THREAT_FROM_FLOOR = 22;
export const DEEP_THREAT_MUL = 5;
export const BOSS_THREAT_EXTRA = 1.5;

/**
 * 斜坡斜率（D114）：层 22 起每层 +0.20，到 ×5 后钳住。
 *
 *   floor 22 → ×1.00（斜坡起点）
 *   floor 27 → ×2.00（教学期后第一道台阶，与「×2 一刀切实测几乎不死」对齐）
 *   floor 42 → ×5.00（钳住，之后恒 ×5：段④ 终点压力不无限增长）
 *
 * 取 0.20 不取 0.25：0.25 在层 38 就顶到 ×5，斜坡只剩 16 层、玩家来不及「学会」；
 * 0.20 给 20 层过渡带，并用实测锚住了斜坡起点。
 */
export const DEEP_THREAT_SLOPE = 0.35;

/**
 * 总开关（D111）：**默认关闭**。
 *
 * 关着的时候倍率不算数 —— 这是有意的，不是漏了开。开它必须同时满足：
 *   1. 死亡代价已生效（D110：本层回到第 1 波 + 6 秒冷却）；
 *   2. 12 种子实测死亡中位 **10~25 次/种子（0.7~1.7 次/小时）**；
 *   3. 满级中位涨幅落在 shuzhi 的验收窗口内。
 * 低于 10 次说明威胁仍然没有意义（防御四通道照样是装饰），高于 25 次说明已经进入劝退区。
 * ×8 被否决的算术：182 死 × 1.8min = +328min ⇒ 满级 ~613min，窗口直接崩。
 */
export const DEEP_THREAT_ENABLED = true;

export function threatMul(floor: number, isBoss: boolean): number {
  if (!DEEP_THREAT_ENABLED) return 1;
  if (!Number.isFinite(floor) || floor < DEEP_THREAT_FROM_FLOOR) return 1;
  const ramp = 1 + DEEP_THREAT_SLOPE * (Math.floor(floor) - DEEP_THREAT_FROM_FLOOR);
  return Math.min(DEEP_THREAT_MUL, ramp) * (isBoss ? BOSS_THREAT_EXTRA : 1);
}

/** 该层打完普通波之后会不会出镇守（层 1~27 每层都有；层 28+ 每 5 层一只） */
export function hasBossFloor(floor: number): boolean {
  if (!Number.isFinite(floor) || floor <= MAIN_FLOOR_END) return true;
  return Math.floor(floor) % BOSS_EVERY_FLOORS === 0;
}

/**
 * 深品阶奖励（0~0.45）：层 28 起每层 +0.05，层 36 封顶。
 *
 * 为什么需要它：无尽层如果只有"怪更硬"，30 分钟后就没人刷了。
 * 为什么封顶在 36：这是给玩家一个**明确的停手点** —— 36 之后掉落品阶不再变好，
 * 只剩渊痕（另一种可见物）。数值上 37+ 与 36 等价，所以 UI 必须换显示口径。
 */
export function depthRarityBonus(floor: number): number {
  if (!Number.isFinite(floor) || floor <= MAIN_FLOOR_END) return 0;
  const raw = (Math.floor(floor) - MAIN_FLOOR_END) * DEPTH_RARITY_PER_FLOOR;
  return Math.min(DEPTH_RARITY_CAP, Math.max(0, raw));
}

/** 神通（fixed 型）在第 floor 层的基础伤害倍率。
 *  baseDamage 的语义是「层 1 当量」：与怪血用同一条曲线（FLOOR_HP_MUL），
 *  法术 DPS 与怪血恒等比，不会出现「第 3 层起法术注定归零」的结构性衰减。
 *  （shuzhi 2026-10-22 神通体检建议 A，已拍板采纳。） */
export function skillFloorScale(floor: number): number {
  return scaleOfFloor(floor).hp;
}

/** 第 `floor` 层击杀一只普通浊物给多少修为（= 2 × 层） */
export function xpPerKill(floor: number): number {
  const f = Number.isFinite(floor) && floor >= 1 ? Math.floor(floor) : 1;
  return XP_PER_KILL_PER_FLOOR * f;
}

/**
 * 镇守的修为系数（D33，2026-10-22 lead 拍板；BALANCE §20.9.2 / §20.13）。
 *
 * 镇守血量恒为**同层普通浊物 ×25**（`BOSS_HP_MUL`），所以它的修为也应该是
 * 「该阶普通浊物赏金均值 ×25」：
 *
 *   一阶 1.05 × 25 = 26.25 → **26**
 *   二阶 3.275 × 25 = 81.875 → **82**
 *   三阶 10.15 × 25 = 253.75 → **254**
 *
 * 曾经三只镇守都写 `xpMul: 30`：一阶相对倍率 28.6×（超发 14%），三阶只剩 2.96×
 * ——镇守波吃掉一层 50~55% 的时间却只给 7~10% 的修为，是「换阶反而变穷」的结构性
 * bug（实测镇守波修为/分 ÷ 普通波修为/分：层 9 = 2.47、层 18 = 1.17、层 27 = 0.08）。
 *
 * ⚠️ 镇守的 `MonsterDef.xpMul`（= 30）现在只是历史残留，**不再被读**；
 * 那个字段的语义是「普通怪的相对赏金」，不要拿它调镇守。
 */
export const BOSS_XP_MUL_BY_TIER: Readonly<Record<1 | 2 | 3, number>> = {
  1: 26,
  2: 82,
  3: 254,
};

/** 某阶（1~3）镇守的修为系数，越界自动钳到 1/3 阶。见 `BOSS_XP_MUL_BY_TIER`。 */
export function bossXpMulOfTier(tier: number): number {
  const t = Number.isFinite(tier) ? Math.min(3, Math.max(1, Math.floor(tier))) : 1;
  return BOSS_XP_MUL_BY_TIER[t as 1 | 2 | 3];
}

/** 校验怪物表（测试和"新增怪忘了填字段"都靠它） */
export function validateMonsters(list: readonly MonsterDef[]): string[] {
  const problems: string[] = [];
  const ids = new Set<string>();
  const elements = new Set<string>(ELEMENT_STAT_KEYS.map((k) => k));
  for (const m of list) {
    if (ids.has(m.id)) problems.push(`怪物 id 重复：${m.id}`);
    ids.add(m.id);
    if (!m.name.trim()) problems.push(`${m.id} 没名字`);
    if (![1, 2, 3].includes(m.tier)) problems.push(`${m.id} 阶数非法：${m.tier}`);
    if (!(m.hpMul > 0)) problems.push(`${m.id} hpMul 必须 > 0`);
    if (!(m.dmgMul > 0)) problems.push(`${m.id} dmgMul 必须 > 0`);
    if (!(m.attackInterval > 0)) problems.push(`${m.id} 攻击间隔必须 > 0`);
    if (!(m.attackRange > 0)) problems.push(`${m.id} 攻击距离必须 > 0`);
    if (!(m.xpMul >= 0)) problems.push(`${m.id} xpMul 必须 >= 0`);
    if (!elements.has(`res${cap(m.element)}`)) problems.push(`${m.id} 属性非法：${m.element}`);
    for (const [k, v] of Object.entries(m.resist ?? {})) {
      if (!Number.isFinite(v)) problems.push(`${m.id} 的抗性 ${k} 不是有限数`);
      if (Math.abs(v) > 1) problems.push(`${m.id} 的抗性 ${k} 超过 100%`);
    }
  }
  for (const t of [1, 2, 3] as const) {
    if (monstersOfTier(t).length === 0) problems.push(`第 ${t} 阶没有普通怪`);
    if (!bossOfTier(t)) problems.push(`第 ${t} 阶没有镇守`);
  }
  return problems;
}

function cap(s: string): string {
  return s.charAt(0).toUpperCase() + s.slice(1);
}
