/**
 * 浊物（怪物）数据表。
 *
 * 三层结构，和九层魔渊对得上：
 * - 第一阶（灵蕴 1~15，渊 1~3 层）：废弃坊市 / 尸解坑 / 断剑宗一带
 * - 第二阶（灵蕴 16~30，渊 4~6 层）：药王谷遗址 / 浊丹炉海 / 万妖巢
 * - 第三阶（灵蕴 31~45，渊 7~9 层）：堕修邪城 / 太清废墟 / 渡劫台
 *
 * 命名原则：**名字要能说出它生前是什么**。
 * 「浊蛆」是垃圾，「坊市怨客」才是暗黑味 —— 玩家看到会想"这地方以前是正常的"。
 *
 * 数值口径（`docs/BALANCE.md` §3 / §11.1，已标定）：
 * - 气血 = 90 × 1.34^(层-1)、攻伐 = 3 × 1.16^(层-1)、每杀修为 = 2 × 层
 * - 表里的 hp/damage/xp 全部写成**第 1 层基准值**，实际值由 `spawnMonster` 按
 *   `FLOOR_HP_MUL` / `FLOOR_DAMAGE_MUL` / 每杀修为公式缩放 ——
 *   数据表只存"这只怪在基准上浮动多少"，曲线全部收口到两个常量。
 * - 镇守：气血 = 同层普通浊物 × 25、攻伐 × 4（BALANCE §11.1）。
 */

import type { ElementTag } from './tags';
import { ELEMENT_STAT_KEYS, type ElementStatKey } from './stats';

/** 怪物稀有度。普通 0 条妖纹 / 魔法 1~2 / 稀有 3~4 / 镇守固定 */
export type MonsterRarity = 'normal' | 'magic' | 'rare' | 'boss';

export const MONSTER_RARITY_NAME: Readonly<Record<MonsterRarity, string>> = {
  normal: '浊物',
  magic: '凶煞',
  rare: '大凶',
  boss: '镇守',
};

/**
 * 每层血量倍率（BALANCE §3：`气血 = 90 × 1.34^(层-1)`）。
 *
 * ⚠️ 不能再用 GDD 的 1.18：装备供给实算 10.9×，1.18^8 只有 3.76×，
 * 会让层 9 一波只要 21 秒、玩家 3 小时通关，8 小时主线直接崩掉（BALANCE §12）。
 */
export const FLOOR_HP_MUL = 1.1534;
/** 每层攻伐倍率（BALANCE v4 D18：1.09 = 玩家气血供给实测 9.3× 的 26 次方根。
 *  基底决定「层 1 有多疼」，growth 决定「疼不疼会变」，两条独立。 */
export const FLOOR_DAMAGE_MUL = 1.09;

/**
 * 主线层数。第一版 3 阶秘境 × 3 层 = 9 层主线（对应九层魔渊）。
 * 无尽层（层 10+）复用第三阶的怪，由层数继续放大 —— 不需要新怪。
 */
export const MAX_FLOOR = 76;

/**
 * 主线末层（= 27）。**和 MAX_FLOOR 是两个概念，别混用。**
 *
 * MAX_FLOOR 是「层数上限」（46）；MAIN_FLOOR_END 是「主线在哪一层结束」（27）。
 * E1 实装时踩过这个坑：MAX_FLOOR 从 27 改成 46 之后，scaleOfFloor / bossHpMul /
 * hasBossFloor / depthRarityBonus 四处仍然拿它当「主线末层」用 → 无尽层的 1.10 曲线、
 * 镇守降幂、每 5 层一只、深品阶奖励**全部没生效**，深段怪血硬 2.4~2.5 倍。
 * 规则：任何「主线/无尽层分界」的判断都用 MAIN_FLOOR_END；「能不能再往下走」用 MAX_FLOOR。
 */
export const MAIN_FLOOR_END = 27;

/**
 * 无尽层起点（D36-A / BALANCE §21.4 E1，2026-10-22 拍板）。
 *
 * 层 1~27 是主线（三阶各 9 层），层 28+ 是无尽层：复用第三阶怪表，
 * 靠层曲线继续放大。**无尽层的存在理由不是"更多层"，而是主线的
 * 「层 36 之后奖励到顶」需要一个能一直刷下去的地方**（24h 目标里无尽层占 3h）。
 */
export const ENDLESS_FLOOR_START = 28;

/**
 * 无尽层每层血量倍率（BALANCE §21.3 实测反推）。
 *
 * 主线用 1.1534（=玩家 40.85× DPS 供给的 26 次方根），但那个系数摊到
 * 层 28+ 会立刻变成死墙：玩家强度天花板实测 ≈877 有效 DPS（层 25~27 中位 548
 * + 天阶仙品 4 条对口 ×1.6 空间），1.1534 到层 33 只剩 7.2 杀/分、层 40 剩 2.7
 * —— 等于做了 13 层没人能玩。1.08 让层 36 还有 8.5 杀/分、层 46 有 4.3。
 */
export const ENDLESS_HP_GROWTH = 1.1;

/**
 * 无尽层镇守血系数下限（上限是主线的 BOSS_HP_MUL=25）。
 *
 * 为什么从 25 线性降到 10 而不是直接换 10：层 28 普通怪 2 103 血，若镇守直接
 * ×10 = 21 030，比层 27 的 48 675 弱 57% —— 玩家一进无尽层会觉得镇守突然变纸。
 * 降到 10 而不是留在 25：镇守从"每层一只"改成"每 5 层一只"，出现密度×5，
 * 血系数若还 ×25，层 36 一只就要 111 秒，每 5 层被强制卡 2 分钟。
 */
export const ENDLESS_BOSS_HP_MUL = 10;

/** 无尽层镇守出现密度：每 N 层一只（层 28 起） */
export const BOSS_EVERY_FLOORS = 5;

/** 深品阶奖励：层 28 起每下潜一层，掉落品阶系数 +0.05（BALANCE §21.4） */
export const DEPTH_RARITY_PER_FLOOR = 0.05;
/** 深品阶奖励封顶（层 36 到 0.45，37+ 不再涨 —— 这也是"玩家停在 36"的数值依据） */
export const DEPTH_RARITY_CAP = 0.45;
/** 镇守血量 = 同层普通 ×8（BALANCE §11.1 的 ×25 与 60~90s 自相矛盾，层 1 要 230s；
 *  ×8 时层 1 = 720 血 / dps 9.8 ≈ 73s 正好落窗。攻伐 ×4 保留。） */
export const BOSS_HP_MUL = 25;
/** 镇守出手间隔（秒）：BALANCE v2 §11.2，难度从抗伤转限时 DPS 检查 */
export const BOSS_ATTACK_INTERVAL = 5;
/** 镇守战内自回：每 10 秒回 10% 气血 */
/** 战内自回比例。v2 定 3%（diag-boss 实测标定，TTK 105/133/119s）；
 *  v4.1 降到 1.5%（BALANCE §17.5，D20）：自回 208→104/s，TTK 130→109s，
 *  少 4 次出手。3% 在层 27 抽走 1/3 玩家 DPS，是镇守战必死的推手之一。 */
export const BOSS_REGEN_RATIO = 0.015;
export const BOSS_REGEN_PERIOD = 10;
/** 镇守攻伐 = 同层普通 ×1.2（BALANCE v4.1 §17.5：v2 的 ×1.5 在层 27 每发 3.81%，
 *  叠加软上限后 2.05%/发；×4 会在 15 层一击打掉 60%+ 气血的结论仍然成立） */
export const BOSS_DMG_MUL = 1.2;

/** 每杀修为 = `XP_PER_KILL_PER_FLOOR × 层`（BALANCE §3） */
export const XP_PER_KILL_PER_FLOOR = 2;

/**
 * 每只怪的血量/攻伐在"层基准"上的个人浮动系数。
 * 基准 = 68 / 1.0（层 1）。锈剑傀 hpMul=0.6667 → 层 1 血 68×0.6667 = 45.3。
 * 这样换掉曲线只动两个常量，不用重写 15 只怪。
 *
 * ⚠️ v4 D18（2026-10-22）：hpMul/dmgMul 已按**阶均值归一**（每阶均值 = 1.00）。
 * 它们现在只表达「同阶内的个体差异」，层的强度全部在 scaleOfFloor 的层曲线上。
 * 这次危机的成因就是把阶强度藏在 hpMul 里（阶轴 ×8.3 血 / ×5.6 攻）叠在层曲线上。
 *
 * ⚠️ v4.6 D30（2026-10-22）：**第三阶 4 个 hpMul 再统一 ×0.7**（均值 1.00 → 0.70）。
 * 原因：层 19 起换三阶怪后，怪血继续按 FLOOR_HP_MUL 指数涨、而玩家 DPS 只能线性涨
 * （装备灵蕴到 99 封顶），实测「修为/分钟」在层 18 见顶 756 后掉到层 19 的 570（−25%）
 * —— 越深的层收益反而更低，玩家理性上应该永远 farm 层 18。砍 30% 血后
 * 击杀 层 19 15→21.4 / 层 27 11.7→16.7，修为/分钟恢复单调（见 BALANCE §20.4）。
 * 同时缓解深层「磨波」与层 24~27 的死亡（怪死得快 → 挨打少）。
 */
export interface MonsterDef {
  readonly id: string;
  readonly name: string;
  /** 所属阶 1~3 */
  readonly tier: 1 | 2 | 3;
  /** 主属性 */
  readonly element: ElementTag;
  /** 血量浮动系数（× 层基准 90） */
  readonly hpMul: number;
  /** 攻伐浮动系数（× 层基准 3） */
  readonly dmgMul: number;
  readonly armor: number;
  /** 五行抗性：主属性抗性高，被克的属性抗性为负（弱点） */
  readonly resist?: Partial<Record<ElementStatKey, number>>;
  /** 每秒移动像素 */
  readonly speed: number;
  /** 攻击间隔（秒） */
  readonly attackInterval: number;
  /** 攻击距离（像素，按 960x540 战场） */
  readonly attackRange: number;
  /** 画多大 */
  readonly size: number;
  /** 修为浮动系数（× 每杀修为基准） */
  readonly xpMul: number;
  /** 是不是镇守 */
  readonly boss?: boolean;
}

/**
 * 层基准值。BALANCE §3 的三个公式的「层 1」：
 * 气血 90（单只 TTK 9.2s）、攻伐 3（每波入伤 24 = 气血的 24%）、每杀修为 2。
 */
/** 68 = 90 × 一阶 hpMul 均值 0.75：归一后均值 1.00，不降基数等于前 9 层怪血整体 ×1.33。
 *  取 68 让层 1 怪血仍 67.5，前 9 层手感一键不变。 */
export const BASE_MONSTER_HP = 68;
/** 1.0：每发伤害 = 玩家气血 0.8%（恒定，BALANCE v4 §16）。不能再低：
 *  battle.ts 伤害有 Math.max(1, …) 地板，波 10 想压到 20% 需每发 0.35，会被地板抬回 1。 */
export const BASE_MONSTER_DAMAGE = 1.0;
/** 层 1 每杀修为（= XP_PER_KILL_PER_FLOOR × 1） */
export const BASE_MONSTER_XP = 2;

const M = (d: MonsterDef): MonsterDef => d;

/**
 * 12 只普通浊物 + 3 只镇守。
 *
 * 每只的属性不是随便配的：一阶里故意留了「高护甲低血」和「低护甲高血」两种，
 * 让玩家在早期就能感觉到「打不动」和「打得动但打不完」是两种问题，
 * 从而理解为什么要堆穿透 / 堆伤害。
