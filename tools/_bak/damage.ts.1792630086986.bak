/**
 * 伤害管线 —— 全游戏唯一一处把「数值」变成「掉多少血」的地方。
 *
 * 设计纪律（三条，违反任何一条都会在后期爆炸）：
 * 1. **纯函数**。不读全局状态、不掷随机数（暴击与否、伤害浮动都由外部传入），
 *    这样离线收益可以拿它跑 8 小时模拟，也可以单测断言精确到小数点。
 * 2. **只有一个入口**。idle-grim 的反例：普攻 / 打怪 / 爆炸 / 受伤四个入口各自补一遍加成，
 *    注释写着「这是唯一一处普攻不走 damageMonster 的伤害来源，所以升华加成要在这里单独补一次」。
 *    结果就是加一个新机制要改四处，漏一处就静默失效。
 * 3. **每一步都留痕**。返回值带 `steps`，直接做成玩家能看的「伤害拆解面板」。
 *    它同时是三样东西：玩家的计算器、我们的调试工具、最好的新手引导。
 *
 * 结算顺序（固定，不可调换）：
 *   基础值 → +flat → ×(1+increased) → ×more → ×外部倍率 → ×随机浮动 → ×暴击
 *   → 减抗/减甲 → 保底 1
 *
 * 为什么顺序不能换：如果先减抗再乘暴击，那么「抗性」的收益会随暴击率变化，
 * 玩家就永远算不清「该堆抗性还是堆暴击」。固定顺序才让 build 可计算。
 */

import { elementOf, type Tag } from '../data/tags';
import type { ElementStatKey } from '../data/stats';
import {
  aggregateDetailed,
  type ModContribution,
  type Modifier,
} from './modifier';

/** 伤害浮动：0.9~1.1，让每次跳字不一样（视觉层需要，不能没有） */
export const DAMAGE_ROLL_MIN = 0.9;
export const DAMAGE_ROLL_MAX = 1.1;

/** 护甲减伤上限：再厚的甲也挡不住 10% */
export const ARMOR_REDUCTION_CAP = 0.9;

/** 护甲公式常量：减伤率 = 护甲 / (护甲 + 50 + 10 × 目标境界) */
export const ARMOR_K = 50;
export const ARMOR_K_PER_LEVEL = 10;

/** 保底伤害：无论多厚的防御，至少掉 1 点，否则会出现「打不动的怪」= 死局 */
export const MIN_DAMAGE = 1;

/** 五行标签 → 对应的抗性属性 key */
export const ELEMENT_RESIST_STAT: Readonly<Record<string, ElementStatKey>> = {
  metal: 'resMetal',
  wood: 'resWood',
  water: 'resWater',
  fire: 'resFire',
  earth: 'resEarth',
};

/** 目标的防御档案 */
export interface DefenseProfile {
  /** 护体值，只减免「无属性」伤害 */
  readonly armor: number;
  /** 五行抗性，缺省按 0 算。可以是负数（被降抗） */
  readonly resist?: Partial<Record<ElementStatKey, number>>;
  /**
   * 攻击方的等级（不是防御方的！）。
   * 护甲边际效应的常数 k = 50 + 10 × 攻方等级：攻方越强，同一件护甲越不值钱。
   * 所以护甲必须随游戏进程一起成长，否则后期等于裸装。
   * 不填按 1 算。
   */
  readonly level?: number;
}

/** 一次伤害计算的输入 */
export interface DamageInput {
  /** 基础伤害：攻击 = 武器伤害 × 技能倍率；法术 = 技能基础值（由技能等级曲线给出） */
  readonly base: number;
  /** 这个伤害实例的标签（决定吃哪些修正器、吃哪种防御） */
  readonly tags: readonly Tag[];
  /** 所有生效的修正器（装备灵纹 + 天赋 + 辅助玉简 + 浊气觉醒 + 怪物妖纹…整包传进来即可） */
  readonly modifiers: readonly Modifier[];
  /** 是否暴击 —— 由外部 rng 决定后传进来，保证本函数是纯函数 */
  readonly isCrit: boolean;
  /** 目标防御；不传 = 无视防御（用于面板显示「裸伤害」） */
  readonly target?: DefenseProfile;
  /** 外部固定倍率（技能自带 more、浊气沸腾、秘境词缀等不属于「修正器」的乘区） */
  readonly externalMore?: number;
  /** 随机浮动系数，默认不浮动（传 null 得期望值）。实际战斗传 0.9~1.1 之间的数 */
  readonly roll?: number | null;
}

/** 一步计算的过程记录 */
export interface DamageStep {
  /** 这一步叫什么（中文，直接显示给玩家） */
  readonly label: string;
  readonly before: number;
  readonly after: number;
  /** 补充说明，如「+50%」「×1.56」「火抗 30%」 */
  readonly note?: string;
}

export interface DamageResult {
  /** 最终伤害（已取整，最小 1） */
  readonly amount: number;
  readonly isCrit: boolean;
  /** 未取整的精确值，单测断言用 */
  readonly raw: number;
  /** 每一步的过程，直接喂给伤害拆解面板 */
  readonly steps: readonly DamageStep[];
  /** 参与了本次结算的每一条修正器（含来源名） */
  readonly contributions: readonly ModContribution[];
}

/**
 * 护甲减伤率（边际效应）。
 *
 * 关键性质：护甲越高，每点护甲带来的减伤越少。
 * 例（目标境界 1，常量 50/10）：护甲 0 → 0%；100 → 62.5%；200 → 76.9%；400 → 87.0%；540 起封顶 90%。
 * 这样「堆护甲」有存在感但不会变成无敌。
 * 注意 `level` 是**攻击方的等级**：怪的等级（层数）越高打你，护甲越不值钱，
 * 所以护甲必须随境界一起成长，否则后期等于裸装。
 */
export function armorReduction(armor: number, level = 1): number {
  if (!Number.isFinite(armor) || armor <= 0) return 0;
  const lv = Number.isFinite(level) && level > 0 ? level : 1;
  const k = ARMOR_K + ARMOR_K_PER_LEVEL * lv;
  const r = armor / (armor + k);
  return Math.min(ARMOR_REDUCTION_CAP, Math.max(0, r));
}

/** 取某个伤害实例对应的抗性值（无属性返回 null） */
export function resistFor(
  tags: readonly Tag[],
  target: DefenseProfile | undefined,
): { key: ElementStatKey; value: number } | null {
  const elem = elementOf(tags);
  if (!elem) return null;
  const key = ELEMENT_RESIST_STAT[elem];
  const value = target?.resist?.[key] ?? 0;
  return { key, value: Number.isFinite(value) ? value : 0 };
}

/**
 * 计算一次伤害。**全游戏唯一入口。**
 *
 * 传 `roll: null` 得到期望值（面板、平衡计算用）；实战传 0.9~1.1 的随机数。
 */
export function computeDamage(input: DamageInput): DamageResult {
  const steps: DamageStep[] = [];
  const tags = input.tags;
  const base = Number.isFinite(input.base) ? Math.max(0, input.base) : 0;

  steps.push({ label: '基础伤害', before: 0, after: base });

  // ① flat：附加固定伤害（「附加 12 点火焰伤害」）
  const detail = aggregateDetailed(input.modifiers, 'damage', tags);
  let cur = base;
  if (detail.agg.flat !== 0) {
    const next = cur + detail.agg.flat;
    steps.push({
      label: '附加伤害',
      before: cur,
      after: next,
      note: `${detail.agg.flat >= 0 ? '+' : ''}${detail.agg.flat.toFixed(1)}`,
    });
    cur = next;
  }

  // ② increased：加算百分比
  if (detail.agg.increased !== 0) {
    const next = cur * (1 + detail.agg.increased);
    steps.push({
      label: '伤害提高',
      before: cur,
      after: next,
      note: `${detail.agg.increased >= 0 ? '+' : ''}${(detail.agg.increased * 100).toFixed(1)}%`,
    });
    cur = next;
  }

  // ③ more：连乘百分比
  if (detail.agg.more !== 1) {
    const next = cur * detail.agg.more;
    steps.push({
      label: '伤害更多',
      before: cur,
      after: next,
      note: `×${detail.agg.more.toFixed(3)}`,
    });
    cur = next;
  }

  // ④ 外部倍率（技能自带、浊气沸腾、秘境词缀）
  const ext = input.externalMore;
  if (ext !== undefined && Number.isFinite(ext) && ext !== 1) {
    const next = cur * ext;
    steps.push({ label: '特殊加成', before: cur, after: next, note: `×${ext.toFixed(3)}` });
    cur = next;
  }

  // ⑤ 随机浮动
  const roll = input.roll;
  if (roll !== undefined && roll !== null && Number.isFinite(roll)) {
    const next = cur * roll;
    steps.push({ label: '伤害浮动', before: cur, after: next, note: `×${roll.toFixed(2)}` });
    cur = next;
  }

  // ⑥ 暴击
  if (input.isCrit) {
    const multi = critMultiplier(input.modifiers);
    const next = cur * multi;
    steps.push({ label: '命中破绽', before: cur, after: next, note: `×${multi.toFixed(2)}` });
    cur = next;
  }

  // ⑦ 防御：五行走抗性，无属性走护甲
  const res = resistFor(tags, input.target);
  if (res) {
    const next = cur * (1 - res.value);
    steps.push({
      label: '五行抗性',
      before: cur,
      after: next,
      note: `${(res.value * 100).toFixed(1)}%`,
    });
    cur = next;
  } else if (input.target) {
    const red = armorReduction(input.target.armor, input.target.level ?? 1);
    if (red > 0) {
      const next = cur * (1 - red);
      steps.push({
        label: '护体减伤',
        before: cur,
        after: next,
        note: `${(red * 100).toFixed(1)}%`,
      });
      cur = next;
    }
  }

  const raw = Math.max(0, cur);
  const amount = Math.max(MIN_DAMAGE, Math.round(raw));

  return {
    amount,
    raw,
    isCrit: input.isCrit,
    steps,
    contributions: detail.parts,
  };
}

/** 从修正器里取破绽伤害倍率（暴击倍率本身也可以被词缀改） */
export function critMultiplier(mods: readonly Modifier[]): number {
  const d = aggregateDetailed(mods, 'critMulti');
  return Math.max(1, (1.5 + d.agg.flat) * (1 + d.agg.increased) * d.agg.more);
}

/** 把 steps 格式化成多行文本（调试日志用；UI 自己遍历 steps 画表格） */
export function formatSteps(result: DamageResult): string {
  const lines = result.steps.map((s) => {
    const note = s.note ? `  (${s.note})` : '';
    return `${s.label.padEnd(6, '　')} ${s.before.toFixed(1)} → ${s.after.toFixed(1)}${note}`;
  });
  lines.push(`最终伤害 ${result.amount}${result.isCrit ? '（破绽）' : ''}`);
  return lines.join('\n');
}
