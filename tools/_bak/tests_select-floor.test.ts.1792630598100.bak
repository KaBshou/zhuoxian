/**
 * D36-B 秘境选层：回刷任意已到过的层，不许跳关。
 *
 * 这一条是「24 小时里后 14 小时干什么」的答案：主线推完之后玩家要能回
 * 低层刷他缺的那件装备，而不是被剧情锁在最高层硬啃。
 */
import { describe, expect, it } from 'vitest';

import {
  createSession,
  floorSelectableMax,
  highestFloorReached,
  setFloor,
  startWave,
  tickSession,
} from '../src/core/session';
import { AFFIXES } from '../src/data/affixes';
import { ITEM_BASES } from '../src/data/bases';

const TABLES = { bases: ITEM_BASES, affixes: AFFIXES };

function makeSession(seed = 12345) {
  const s = createSession({ classId: 'yujian', seed, tables: TABLES, autoTalents: false });
  startWave(s);
  return s;
}

describe('秘境选层（D36-B）', () => {
  it('新号只能待在第 1 层', () => {
    const s = makeSession();
    expect(s.floor).toBe(1);
    expect(highestFloorReached(s)).toBe(1);
    expect(floorSelectableMax(s)).toBe(1);
    expect(setFloor(s, 5)).toBe(false);
    expect(s.floor).toBe(1);
  });

  it('到过第 3 层之后能回到第 1 层，但选不了第 4 层', () => {
    const s = makeSession();
    // 模拟「已经推进到第 3 层」：直接摆状态比跑 30 波快得多，测的是规则不是战斗
    s.floor = 3;
    s.wave = 7;
    s.firstClearedFloors.push(1, 2);
    expect(highestFloorReached(s)).toBe(3);
    expect(floorSelectableMax(s)).toBe(3);

    expect(setFloor(s, 1)).toBe(true);
    expect(s.floor).toBe(1);
    expect(setFloor(s, 4)).toBe(false);
    expect(s.floor).toBe(1);
  });

  it('回刷之后仍然记得曾经到过多深（否则一路回退就再也上不去）', () => {
    const s = makeSession();
    s.floor = 6;
    s.firstClearedFloors.push(1, 2, 3, 4, 5);
    expect(setFloor(s, 2)).toBe(true);
    expect(highestFloorReached(s)).toBe(6);
    expect(floorSelectableMax(s)).toBe(6);
    // 能再回第 6 层
    expect(setFloor(s, 6)).toBe(true);
    expect(s.floor).toBe(6);
  });

  it('换层要清场：不保留旧层的半场战斗和地上掉落', () => {
    const s = makeSession();
    s.floor = 3;
    s.firstClearedFloors.push(1, 2);
    tickSession(s, 1 / 30); // 让本层有怪
    expect(s.battle.monsters.length).toBeGreaterThan(0);
    s.ground.push({ id: 1, x: 10, y: 10, item: s.character.equipment.sword!, age: 5, picked: false });
    s.wave = 4;

    expect(setFloor(s, 1)).toBe(true);
    expect(s.wave).toBe(0);
    expect(s.ground.length).toBe(0);
    expect(s.battle.monsters.every((m) => m.tier === 1)).toBe(true);
  });

  it('换层是移动不是重开：修为、浊气、装备都不动', () => {
    const s = makeSession();
    s.floor = 3;
    s.firstClearedFloors.push(1, 2);
    s.character.xp = 777;
    s.battle.turbid.value = 42;
    const before = {
      xp: s.character.xp,
      step: s.character.step,
      turbid: s.battle.turbid.value,
      sword: s.character.equipment.sword?.uid,
    };

    expect(setFloor(s, 2)).toBe(true);
    expect(s.character.xp).toBe(before.xp);
    expect(s.character.step).toBe(before.step);
    expect(s.battle.turbid.value).toBe(before.turbid);
    expect(s.character.equipment.sword?.uid).toBe(before.sword);
  });

  it('换层会留一条日志，并把波次真的重开', () => {
    const s = makeSession();
    s.floor = 2;
    s.firstClearedFloors.push(1);
    expect(setFloor(s, 1)).toBe(true);
    expect(s.log.some((l) => l.text.includes('转入第 1 层'))).toBe(true);
    // 新一波马上开（startWave 会把怪放上场）
    expect(s.battle.monsters.length).toBeGreaterThan(0);
  });

  it('非法输入不炸：NaN / 负数 / 同层都返回 false', () => {
    const s = makeSession();
    expect(setFloor(s, Number.NaN)).toBe(false);
    expect(setFloor(s, -5)).toBe(false);
    expect(setFloor(s, 1)).toBe(false); // 已经在这层
    expect(s.floor).toBe(1);
  });
});
