/**
 * 战斗渲染 —— 只负责「把状态画成像素」，不含任何规则。
 *
 * 严格分工：`src/core/` 决定发生什么，这里只决定怎么显示。
 * 所以这个文件里不该出现任何 `hp -= ...` 或 `if (crit) damage *= 1.5`。
 * 一旦规则漏进渲染层，离线收益（没有渲染）就会和在线结果不一致 ——
 * 那是最难查的一类 bug，因为两边都"看起来正常"。
 *
 * 画法参考 idle-grim（同一套视觉语言，玩家在两个作品之间会有连续感）：
 * 石砖地板 + 墙体 + 视野暗角 + 径向渐变的怪 + 职业色光环的玩家 + 掉落光柱。
 * 关键手法是「三档渐变」：同一块颜色用 lighten/darken 拉出体积，
 * 纯色平涂在暗黑风里会显得像纸片。
 */

import {
  BATTLE_H,
  BATTLE_W,
  hpRatio,
  type BattleState,
  type MonsterInPlay,
} from '../core/battle';
import type { GameSession } from '../core/session';
import type { TurbidState } from '../core/turbid';
import { TURBID_MAX } from '../core/turbid';
import type { ElementTag } from '../data/tags';
import type { Rarity } from '../data/rarity';
import { drawHudStack } from './hud-panels';
import { drawEquipmentDetail } from './detail-panels';

/** 调色板（沿用 GDD 七色） */
const C = {
  void: '#05070b',
  bg: '#0b0a0c',
  stone: [26, 30, 38] as const,
  stoneEdge: '#0a0d13',
  wall: '#151c26',
  wallLight: '#1e2632',
  player: '#4fd1c5',
  playerEdge: '#8eeae2',
  hpBack: '#2a1a1a',
  hpFill: '#8c3a2e',
  hpGood: '#8fd45a',
  shield: '#d4a13c',
  turbidBack: '#2a1a3a',
  turbidFill: '#6b3fa0',
  turbidHot: '#c25a48',
  text: '#d8d3c4',
  dim: '#6d665c',
  barBack: '#14121a',
  barEdge: '#2a2419',
  gold: '#d4a13c',
} as const;

/** 五行 → 颜色（怪的身体色，玩家一眼能分辨"这批怪是什么属性"） */
export const ELEMENT_COLOR: Readonly<Record<ElementTag, string>> = {
  metal: '#c9a24a',
  wood: '#4a7f50',
  water: '#3a72b8',
  fire: '#c25a48',
  earth: '#8a6520',
};

/** 稀有度 → 描边色（越稀有越亮，玩家靠颜色判断"要不要捡"） */
const RARITY_EDGE: Readonly<Record<string, string>> = {
  normal: '#00000000',
  magic: '#4d86cc',
  rare: '#d4a13c',
  boss: '#e05a3a',
};

/** 掉落光柱颜色（凡品故意很暗，让好东西一眼跳出来） */
const DROP_COLOR: Readonly<Record<Rarity, string>> = {
  fan: 'rgba(200,212,228,0.42)',
  ling: 'rgba(80,150,240,0.62)',
  bao: 'rgba(240,210,100,0.72)',
  xian: 'rgba(245,150,55,0.82)',
};

const TILE = 64;
const MAP_W = Math.ceil(BATTLE_W / TILE);
const MAP_H = Math.ceil(BATTLE_H / TILE);

export class BattleRenderer {
  private readonly ctx: CanvasRenderingContext2D;
  /** 地板离屏画布：只画一次，之后每帧贴图（重绘 60 次/秒纯属浪费） */
  private floor: HTMLCanvasElement | null = null;
  /** 当前地板是按哪一阶画的，换阶才重建 */
  private floorTier = -1;
  /** 是否显示「损伤详解」面板（按 D 切换） */
  private showBreakdown = false;

  /** 法宝详情（按 E）。和损伤详解一样是"按需覆盖"的调试/阅读层 */
  private showDetail = false;

  /** 切换法宝详情，返回切换后的状态 */
  toggleDetail(): boolean {
    this.showDetail = !this.showDetail;
    return this.showDetail;
  }

  /** 详情是否开着（探针用） */
  get detailVisible(): boolean {
    return this.showDetail;
  }

  /** 切换损伤详解面板，返回切换后的状态 */
  toggleBreakdown(): boolean {
    this.showBreakdown = !this.showBreakdown;
    return this.showBreakdown;
  }

  get breakdownVisible(): boolean {
    return this.showBreakdown;
  }

  constructor(private readonly canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) throw new Error('拿不到 canvas 2d 上下文，浏览器不支持或被占用了');
    this.ctx = ctx;
  }

  render(s: GameSession): void {
    const ctx = this.ctx;
    const state = s.battle;
    const t = state.time;

    ctx.fillStyle = C.void;
    ctx.fillRect(0, 0, BATTLE_W, BATTLE_H);

    this.ensureFloor(s.floor);
    if (this.floor) ctx.drawImage(this.floor, 0, 0);

    // 掉落光柱画在实体下面（否则会糊住怪的脸）
    for (const g of s.ground) this.drawGroundDrop(g.x, g.y, g.item.rarity, g.age);

    for (const m of state.monsters) this.drawMonster(m, t, state.player.x, state.player.y);
    this.drawPlayer(state, t);

    for (const f of s.floats) this.drawFloat(f);

    this.drawLighting(state.player.x, state.player.y);
    this.drawTopBars(state);
    this.drawLog(s);
    this.drawHudPanels(s);
    if (this.showBreakdown) this.drawBreakdown(s);
    if (this.showDetail) drawEquipmentDetail(this.ctx, s);
    this.drawOfflineReport(s);
  }

  /**
   * 闭关（离线）结算摘要。
   *
   * 为什么一定要画出来：玩家关页面 8 小时再打开，如果界面上什么都没有，
   * 他会以为「挂着不划算」或者「是不是没存上」。三行数字（时长/击杀/修为+出货）
   * 是放置游戏唯一能证明「离线也在赚」的东西。
   *
   * 12 秒后淡出（age 由 main.ts 推进），不挡操作、不需要点击确认。
   */
  private drawOfflineReport(s: GameSession): void {
    const r = s.offlineReport;
    if (!r) return;
    const ctx = this.ctx;
    const fade = r.age < 10 ? 1 : Math.max(0, (12 - r.age) / 2);
    const w = 300;
    const h = 92;
    const x = (BATTLE_W - w) / 2;
    const y = 60;
    ctx.save();
    ctx.globalAlpha = 0.92 * fade;
    ctx.fillStyle = 'rgba(11,10,12,0.92)';
    ctx.fillRect(x, y, w, h);
    ctx.strokeStyle = 'rgba(212,161,60,0.55)';
    ctx.lineWidth = 1;
    ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);

    ctx.textAlign = 'center';
    ctx.fillStyle = '#d4a13c';
    ctx.font = '600 15px "Noto Sans SC", system-ui, sans-serif';
    const hours = r.minutes >= 60 ? `${Math.floor(r.minutes / 60)} 小时 ` : '';
    const mins = r.minutes >= 60 ? Math.round(r.minutes % 60) : Math.round(r.minutes);
    ctx.fillText(`闭关 ${hours}${mins} 分钟${r.capped ? '（已达上限）' : ''}`, x + w / 2, y + 26);

    ctx.textAlign = 'left';
    ctx.font = '13px "Noto Sans SC", system-ui, sans-serif';
    ctx.fillStyle = '#d8d3c4';
    ctx.fillText(`击杀浊物　${r.kills}`, x + 26, y + 50);
    ctx.fillText(`修为　　　+${r.xp}`, x + 26, y + 68);
    ctx.fillStyle = '#8eeae2';
    ctx.fillText(`出货　　　${r.items + r.currency + r.gems} 件`, x + 26, y + 86);
    ctx.restore();
  }

  // ────────────────────────────────────────────────────────
  // 地板（离屏，只画一次）
  // ────────────────────────────────────────────────────────

  private ensureFloor(tier: number): void {
    if (this.floor && this.floorTier === tier) return;
    this.floorTier = tier;
    const c = document.createElement('canvas');
    c.width = BATTLE_W;
    c.height = BATTLE_H;
    const g = c.getContext('2d');
    if (!g) return;

    // 每阶换一套基色：越深越冷越脏
    const shift = (tier - 1) * 4;
    const [br, bg, bb] = C.stone;
    g.fillStyle = `rgb(${br - shift},${bg - shift},${bb - shift})`;
    g.fillRect(0, 0, c.width, c.height);

    for (let ty = 0; ty < MAP_H; ty++) {
      for (let tx = 0; tx < MAP_W; tx++) {
        const x = tx * TILE;
        const y = ty * TILE;
        // 哈希出「这块砖长什么样」：不用 rng，保证同一阶每次进来地板完全一样
        const n = ((tx * 73856093) ^ (ty * 19349663)) >>> 0;
        const v = (n % 11) / 11;
        const shade = Math.floor(v * 14) - shift;
        g.fillStyle = `rgb(${br + shade},${bg + shade},${bb + shade})`;
        g.fillRect(x + 1, y + 1, TILE - 2, TILE - 2);

        // 顶部一条高光 + 底部一条阴影 = 砖块的厚度感
        g.fillStyle = 'rgba(255,255,255,0.05)';
        g.fillRect(x + 1, y + 1, TILE - 2, 1.5);
        g.fillStyle = 'rgba(0,0,0,0.4)';
        g.fillRect(x + 1, y + TILE - 2, TILE - 2, 1.5);

        // 砖缝
        g.fillStyle = 'rgba(0,0,0,0.55)';
        g.fillRect(x, y, 1, TILE);
        g.fillRect(x, y, TILE, 1);

        // 偶尔一道裂缝、偶尔一摊苔藓 —— 全一样的砖看着像瓷砖
        if (n % 19 === 0) {
          g.strokeStyle = 'rgba(0,0,0,0.5)';
          g.lineWidth = 1.2;
          g.beginPath();
          g.moveTo(x + TILE * 0.3, y + TILE * 0.35);
          g.lineTo(x + TILE * 0.55, y + TILE * 0.6);
          g.lineTo(x + TILE * 0.45, y + TILE * 0.8);
          g.stroke();
        } else if (n % 13 === 0) {
          g.fillStyle = 'rgba(90,130,90,0.06)';
          g.beginPath();
          g.arc(x + TILE * 0.5, y + TILE * 0.5, TILE * 0.32, 0, Math.PI * 2);
          g.fill();
        }
      }
    }

    // 四周墙体：把战场框成一个「房间」，否则玩家不知道边界在哪
    g.fillStyle = C.wall;
    g.fillRect(0, 0, c.width, 14);
    g.fillRect(0, c.height - 14, c.width, 14);
    g.fillRect(0, 0, 14, c.height);
    g.fillRect(c.width - 14, 0, 14, c.height);
    g.strokeStyle = 'rgba(140,165,200,0.10)';
    g.lineWidth = 1;
    g.strokeRect(14.5, 14.5, c.width - 29, c.height - 29);

    // 中央法阵：站桩位置有个标记，玩家一眼知道自己站哪
    const cx = BATTLE_W / 2;
    const cy = BATTLE_H / 2;
    g.save();
    g.translate(cx, cy);
    g.strokeStyle = 'rgba(79,209,197,0.10)';
    g.lineWidth = 2;
    g.beginPath();
    g.arc(0, 0, 78, 0, Math.PI * 2);
    g.stroke();
    g.lineWidth = 1;
    g.beginPath();
    g.arc(0, 0, 92, 0, Math.PI * 2);
    g.stroke();
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * Math.PI * 2;
      g.beginPath();
      g.moveTo(Math.cos(a) * 78, Math.sin(a) * 78);
      g.lineTo(Math.cos(a) * 92, Math.sin(a) * 92);
      g.stroke();
    }
    g.restore();

    this.floor = c;
  }

  // ────────────────────────────────────────────────────────
  // 怪物
  // ────────────────────────────────────────────────────────

  private drawMonster(m: MonsterInPlay, t: number, px: number, py: number): void {
    const ctx = this.ctx;
    const r = m.size / 2;
    const bob = Math.sin(t * 4 + m.uid * 1.7) * 1.4;
    const color = ELEMENT_COLOR[m.element] ?? '#8c3a2e';
    const ang = Math.atan2(py - m.y, px - m.x);

    // 影子
    ctx.fillStyle = 'rgba(0,0,0,0.45)';
    ctx.beginPath();
    ctx.ellipse(m.x, m.y + r * 0.85, r * 0.9, r * 0.36, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.save();
    ctx.translate(m.x, m.y + bob);

    // 镇守：外圈光环，远远就能看出"这只不一样"
    if (m.rarity === 'boss') {
      const aura = ctx.createRadialGradient(0, 0, r * 0.6, 0, 0, r * 2.1);
      aura.addColorStop(0, hexA(color, 0.26));
      aura.addColorStop(1, hexA(color, 0));
      ctx.fillStyle = aura;
      ctx.beginPath();
      ctx.arc(0, 0, r * 2.1, 0, Math.PI * 2);
      ctx.fill();
    }

    // 呼吸：身体半径轻微起伏，静止的怪看起来像死的
    const bodyR = r * (1 + Math.sin(t * 5 + m.uid) * 0.05);

    // 身体：径向渐变（左上亮、边缘暗）
    const grad = ctx.createRadialGradient(-bodyR * 0.35, -bodyR * 0.4, bodyR * 0.15, 0, 0, bodyR);
    grad.addColorStop(0, lighten(color, 0.3));
    grad.addColorStop(0.55, color);
    grad.addColorStop(1, lighten(color, -0.32));
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.ellipse(0, 0, bodyR, bodyR * 0.94, 0, 0, Math.PI * 2);
    ctx.fill();

    // 底部压影
    ctx.fillStyle = 'rgba(0,0,0,0.16)';
    ctx.beginPath();
    ctx.ellipse(0, bodyR * 0.45, bodyR * 0.72, bodyR * 0.32, 0, 0, Math.PI * 2);
    ctx.fill();

    // 描边（暗黑风必须有硬边，纯渐变会糊成一团）
    ctx.strokeStyle = 'rgba(4,6,10,0.85)';
    ctx.lineWidth = Math.max(1.6, r * 0.14);
    ctx.beginPath();
    ctx.ellipse(0, 0, bodyR, bodyR * 0.94, 0, 0, Math.PI * 2);
    ctx.stroke();

    // 朝向玩家的双眼：位置跟着玩家转，一眼看出"它在盯我"
    const ex = Math.cos(ang) * bodyR * 0.34;
    const ey = Math.sin(ang) * bodyR * 0.3 - bodyR * 0.06;
    const eyeR = Math.max(1.6, r * 0.19);
    ctx.fillStyle = '#190a0a';
    ctx.beginPath();
    ctx.arc(ex - eyeR * 1.6, ey, eyeR * 1.3, 0, Math.PI * 2);
    ctx.arc(ex + eyeR * 1.6, ey, eyeR * 1.3, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = m.rarity === 'boss' ? '#ff7a4a' : '#e0453a';
    ctx.shadowColor = ctx.fillStyle;
    ctx.shadowBlur = 7;
    ctx.beginPath();
    ctx.arc(ex - eyeR * 1.6, ey, eyeR * 0.62, 0, Math.PI * 2);
    ctx.arc(ex + eyeR * 1.6, ey, eyeR * 0.62, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;

    // 镇守尖角
    if (m.rarity === 'boss') {
      ctx.fillStyle = lighten(color, -0.4);
      for (const sgn of [-1, 1]) {
        ctx.beginPath();
        ctx.moveTo(sgn * bodyR * 0.55, -bodyR * 0.72);
        ctx.lineTo(sgn * bodyR * 0.95, -bodyR * 1.45);
        ctx.lineTo(sgn * bodyR * 0.22, -bodyR * 1.0);
        ctx.closePath();
        ctx.fill();
      }
    }

    // 出手前的蓄力光点（放在玩家方向，读得出"它要打了"）
    if (m.cooldown > 0 && m.cooldown < 0.35) {
      const k = 1 - m.cooldown / 0.35;
      ctx.fillStyle = hexA('#ff9a6a', 0.85 * k);
      ctx.shadowColor = '#ff9a6a';
      ctx.shadowBlur = 14 * k;
      ctx.beginPath();
      ctx.arc(Math.cos(ang) * (bodyR + 6), Math.sin(ang) * (bodyR + 6), 2.2 + 2.6 * k, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    ctx.restore();

    // 血条（掉血后才画，满血的怪不画，否则画面一片条形码）
    if (m.hp < m.maxHp) {
      const w = r * 2;
      ctx.fillStyle = 'rgba(0,0,0,0.62)';
      ctx.fillRect(m.x - w / 2, m.y - r - 8, w, 4);
      ctx.fillStyle = m.rarity === 'boss' ? '#e05a4a' : C.hpGood;
      ctx.fillRect(m.x - w / 2, m.y - r - 8, w * Math.max(0, Math.min(1, m.hp / m.maxHp)), 4);
    }

    // 稀有度描边标记（魔法蓝 / 稀有金 / 镇守红）
    const edge = RARITY_EDGE[m.rarity];
    if (edge && m.rarity !== 'normal') {
      ctx.strokeStyle = edge;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(m.x, m.y + bob, r + 4, 0, Math.PI * 2);
      ctx.stroke();
    }

    // 镇守名字
    if (m.rarity === 'boss') {
      ctx.fillStyle = 'rgba(255,220,150,0.92)';
      ctx.font = '600 12px "Noto Sans SC", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText(m.name, m.x, m.y - r - 14);
    }
  }

  // ────────────────────────────────────────────────────────
  // 玩家
  // ────────────────────────────────────────────────────────

  private drawPlayer(state: BattleState, t: number): void {
    const ctx = this.ctx;
    const p = state.player;
    const dead = state.reviveCooldown > 0;
    const bob = Math.sin(t * 2.4) * 0.9;

    // 影子
    ctx.fillStyle = 'rgba(0,0,0,0.5)';
    ctx.beginPath();
    ctx.ellipse(p.x, p.y + 14, 13, 4.8, 0, 0, Math.PI * 2);
    ctx.fill();

    // 脚下光环：让玩家在满屏怪里一眼找到自己
    const halo = ctx.createRadialGradient(p.x, p.y + 12, 0, p.x, p.y + 12, 38);
    halo.addColorStop(0, hexA(C.player, 0.24));
    halo.addColorStop(1, hexA(C.player, 0));
    ctx.fillStyle = halo;
    ctx.beginPath();
    ctx.ellipse(p.x, p.y + 12, 38, 14, 0, 0, Math.PI * 2);
    ctx.fill();

    if (dead) ctx.globalAlpha = 0.28;

    ctx.save();
    ctx.translate(p.x, p.y + bob);

    // 剑（竖在身侧，暗黑风里武器是身份）
    ctx.fillStyle = '#b8c6d8';
    ctx.fillRect(11, -14, 2.4, 22);
    ctx.fillStyle = C.playerEdge;
    ctx.fillRect(10, -16, 4.4, 3);
    ctx.fillStyle = '#7a6440';
    ctx.fillRect(9.6, 8, 5.2, 2.4);

    // 道袍：下摆略开
    const robe = ctx.createLinearGradient(0, -10, 0, 12);
    robe.addColorStop(0, lighten(C.player, 0.1));
    robe.addColorStop(1, lighten(C.player, -0.45));
    ctx.fillStyle = robe;
    ctx.beginPath();
    ctx.moveTo(-7.5, -8);
    ctx.quadraticCurveTo(0, -12, 7.5, -8);
    ctx.lineTo(6, 11);
    ctx.quadraticCurveTo(0, 13, -6, 11);
    ctx.closePath();
    ctx.fill();

    // 腰带
    ctx.fillStyle = C.gold;
    ctx.fillRect(-6, 2.4, 12, 1.6);

    // 肩
    ctx.fillStyle = lighten(C.player, 0.32);
    ctx.beginPath();
    ctx.ellipse(-7.4, -7.4, 3.6, 2.8, -0.3, 0, Math.PI * 2);
    ctx.ellipse(7.4, -7.4, 3.6, 2.8, 0.3, 0, Math.PI * 2);
    ctx.fill();

    // 头
    ctx.fillStyle = '#e8c9a8';
    ctx.beginPath();
    ctx.arc(0, -14, 5.2, 0, Math.PI * 2);
    ctx.fill();

    // 发髻 + 发带（修仙味全在这个髻上）
    ctx.fillStyle = '#221a1a';
    ctx.beginPath();
    ctx.arc(0, -16.4, 5.4, Math.PI, Math.PI * 2);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(0, -20, 2.4, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = C.playerEdge;
    ctx.fillRect(-5.2, -17.4, 10.4, 1.4);

    ctx.restore();
    ctx.globalAlpha = 1;

    // 气血条（玩家自己头上也画一条，不用抬头看顶栏）
    const w = 44;
    this.drawBar(p.x - w / 2, p.y - 30, w, 4, hpRatio(state), C.hpFill);
    if (p.shield > 0) {
      const r = Math.min(1, p.shield / Math.max(1, p.maxHp * 0.3));
      this.drawBar(p.x - w / 2, p.y - 24, w, 3, r, C.shield);
    }

    if (dead) {
      ctx.fillStyle = 'rgba(224,90,58,0.9)';
      ctx.font = '600 12px "Noto Sans SC", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(`浊脉重凝 ${state.reviveCooldown.toFixed(1)}s`, p.x, p.y - 40);
    }
  }

  // ────────────────────────────────────────────────────────
  // 掉落物
  // ────────────────────────────────────────────────────────

  private drawGroundDrop(x: number, y: number, rarity: Rarity, age: number): void {
    const ctx = this.ctx;
    const col = DROP_COLOR[rarity];
    const bob = Math.sin(age * 3.2) * 3;

    // 地面光斑
    const halo = ctx.createRadialGradient(x, y + 8, 0, x, y + 8, 30);
    halo.addColorStop(0, col.replace(/[\d.]+\)$/, '0.26)'));
    halo.addColorStop(1, col.replace(/[\d.]+\)$/, '0)'));
    ctx.fillStyle = halo;
    ctx.fillRect(x - 30, y - 22, 60, 60);

    // 光柱：远远就能看见地上有东西
    const beam = ctx.createLinearGradient(x, y - 46, x, y + 8);
    beam.addColorStop(0, 'rgba(0,0,0,0)');
    beam.addColorStop(0.55, col.replace(/[\d.]+\)$/, '0.32)'));
    beam.addColorStop(1, col.replace(/[\d.]+\)$/, '0.52)'));
    ctx.fillStyle = beam;
    ctx.beginPath();
    ctx.moveTo(x - 5, y - 46);
    ctx.lineTo(x + 5, y - 46);
    ctx.lineTo(x + 11, y + 8);
    ctx.lineTo(x - 11, y + 8);
    ctx.closePath();
    ctx.fill();

    // 落点光圈
    ctx.strokeStyle = col;
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.ellipse(x, y + 8, 13, 5, 0, 0, Math.PI * 2);
    ctx.stroke();

    // 漂浮的小方块本体
    ctx.save();
    ctx.translate(x, y + bob - 8);
    ctx.rotate(Math.sin(age * 1.7) * 0.22);
    ctx.fillStyle = col;
    ctx.shadowColor = col;
    ctx.shadowBlur = 10;
    ctx.fillRect(-5, -5, 10, 10);
    ctx.restore();
  }

  // ────────────────────────────────────────────────────────
  // 浮字 / 暗角 / 顶栏 / 日志
  // ────────────────────────────────────────────────────────

  private drawFloat(f: { text: string; x: number; y: number; color: string; age: number; life: number; rise: number }): void {
    const ctx = this.ctx;
    const k = Math.max(0, Math.min(1, f.age / f.life));
    const alpha = 1 - k * k;
    const y = f.y - f.rise * k;
    ctx.globalAlpha = alpha;
    ctx.textAlign = 'center';
    ctx.font = '700 15px "Consolas", "Courier New", monospace';
    ctx.fillStyle = 'rgba(0,0,0,0.8)';
    ctx.fillText(f.text, f.x + 1.2, y + 1.2);
    ctx.fillStyle = f.color;
    ctx.fillText(f.text, f.x, y);
    ctx.globalAlpha = 1;
  }

  /** 视野暗角：玩家周围亮、边缘暗。这是"暗黑"两个字的视觉落点 */
  private drawLighting(px: number, py: number): void {
    const ctx = this.ctx;
    const grad = ctx.createRadialGradient(px, py, 100, px, py, 460);
    grad.addColorStop(0, 'rgba(0,0,0,0)');
    grad.addColorStop(0.5, 'rgba(0,0,0,0.06)');
    grad.addColorStop(0.78, 'rgba(0,0,0,0.36)');
    grad.addColorStop(1, 'rgba(0,0,0,0.70)');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, BATTLE_W, BATTLE_H);

    // 一点暖光，避免整体偏冷发蓝
    const warm = ctx.createRadialGradient(px, py, 0, px, py, 220);
    warm.addColorStop(0, 'rgba(255,190,110,0.07)');
    warm.addColorStop(1, 'rgba(255,190,110,0)');
    ctx.fillStyle = warm;
    ctx.fillRect(0, 0, BATTLE_W, BATTLE_H);
  }

  private drawTopBars(state: BattleState): void {
    const ctx = this.ctx;
    ctx.fillStyle = C.barBack;
    ctx.fillRect(0, 0, BATTLE_W, 38);
    ctx.strokeStyle = C.barEdge;
    ctx.lineWidth = 1;
    ctx.strokeRect(0.5, 0.5, BATTLE_W - 1, 37);

    // 气血
    this.drawBar(12, 8, 230, 10, hpRatio(state), C.hpFill);
    ctx.fillStyle = C.dim;
    ctx.font = '11px "Noto Sans SC", system-ui, sans-serif';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'alphabetic';
    ctx.fillText(
      `气血 ${Math.ceil(state.player.hp)} / ${Math.ceil(state.player.maxHp)}`,
      12,
      33,
    );

    // 浊气（本作核心：越满伤害越高、回复越低）
    this.drawTurbid(state.turbid, 262, 8, 230, 10);
    ctx.fillStyle = C.dim;
    ctx.fillText(turbidText(state.turbid), 262, 33);

    // 护体罡气（有才显示）
    if (state.player.shield > 0) {
      this.drawBar(512, 8, 120, 10, Math.min(1, state.player.shield / Math.max(1, state.player.maxHp * 0.3)), C.shield);
      ctx.fillStyle = C.dim;
      ctx.fillText(`罡气 ${Math.ceil(state.player.shield)}`, 512, 33);
    }
  }

  private drawTurbid(t: TurbidState, x: number, y: number, w: number, h: number): void {
    const ctx = this.ctx;
    ctx.fillStyle = C.turbidBack;
    ctx.fillRect(x, y, w, h);
    const ratio = Math.max(0, Math.min(1, t.value / TURBID_MAX));
    // 越接近满越红：玩家不用读数字就知道"快炸了"
    const fill = t.phase === 'calm' ? (ratio > 0.7 ? C.turbidHot : C.turbidFill) : C.turbidHot;
    ctx.fillStyle = fill;
    ctx.fillRect(x, y, w * ratio, h);
    if (t.phase !== 'calm') {
      ctx.strokeStyle = C.turbidHot;
      ctx.lineWidth = 1;
      ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
    }
  }

  private drawHudPanels(s: GameSession): void {
    // 四块面板（状态 / 法宝 / 囊中 / 背包）由 hud-panels 自己按高度堆叠，
    // 这里不给坐标 —— 行数是变的，写死坐标一改行数就叠在一起。
    drawHudStack(this.ctx, s);
  }

  /**
   * 损伤详解：把 computeDamage 留下的一步步摊开给玩家看。
   *
   * 为什么值得做（GDD 4.7）：它同时是三样东西 ——
   * 玩家的计算器（"我该堆破绽还是堆伤害"能被算出来）、
   * 我们的调试工具（面板和实战数字永远同源，不会有第二套公式）、
   * 最好的新手引导（比任何文字教程都直观）。
   */
  private drawBreakdown(s: GameSession): void {
    const bd = s.battle.lastBreakdown;
    if (!bd) return;
    const ctx = this.ctx;
    const lines = bd.steps.slice(-6);
    // 挪到左上：右上角被 HUD 面板占了，左下角是战斗日志
    const W = 300;
    const H = 40 + lines.length * 15;
    const X = 14;
    const Y = 44;

    ctx.fillStyle = 'rgba(11,10,12,0.86)';
    ctx.fillRect(X, Y, W, H);
    ctx.strokeStyle = 'rgba(140,165,200,0.22)';
    ctx.lineWidth = 1;
    ctx.strokeRect(X + 0.5, Y + 0.5, W - 1, H - 1);

    ctx.textAlign = 'left';
    ctx.font = '11px "Noto Sans SC", system-ui, sans-serif';
    ctx.fillStyle = C.dim;
    ctx.fillText('损伤详解（D 关闭）', X + 10, Y + 16);
    ctx.fillStyle = C.text;
    ctx.fillText(bd.label, X + 10, Y + 32);

    let y = Y + 48;
    for (const st of lines) {
      ctx.fillStyle = C.dim;
      ctx.fillText(st.label, X + 10, y);
      ctx.fillStyle = C.text;
      ctx.textAlign = 'right';
      ctx.fillText(`${st.before.toFixed(1)} → ${st.after.toFixed(1)}`, X + W - 10, y);
      ctx.textAlign = 'left';
      y += 15;
    }

    ctx.textAlign = 'right';
    ctx.fillStyle = bd.isCrit ? C.gold ?? '#d4a13c' : C.playerEdge;
    ctx.fillText(`最终 ${bd.amount}${bd.isCrit ? '（破绽）' : ''}`, X + W - 10, Y + H - 8);
    ctx.textAlign = 'left';
  }

  private drawLog(s: GameSession): void {
    const ctx = this.ctx;
    ctx.textAlign = 'left';
    ctx.font = '11px "Noto Sans SC", system-ui, sans-serif';
    let y = BATTLE_H - 14;
    for (let i = s.log.length - 1; i >= 0; i--) {
      const l = s.log[i];
      if (!l) continue;
      // 越老的越淡，读得出时间顺序
      ctx.globalAlpha = Math.max(0.15, 1 - i * 0.16);
      ctx.fillStyle = l.color;
      ctx.fillText(l.text, 16, y);
      y -= 16;
      if (y < BATTLE_H - 90) break;
    }
    ctx.globalAlpha = 1;

    // 右下角统计
    ctx.textAlign = 'right';
    ctx.fillStyle = C.dim;
    ctx.fillText(
      `第 ${s.wave} 波　${s.floor} 层　击杀 ${s.battle.kills}　掉落 ${s.dropsFound}　←→ 回刷`,
      BATTLE_W - 16,
      BATTLE_H - 14,
    );
  }

  private drawBar(x: number, y: number, w: number, h: number, ratio: number, color: string): void {
    const ctx = this.ctx;
    const r = Math.max(0, Math.min(1, Number.isFinite(ratio) ? ratio : 0));
    ctx.fillStyle = C.hpBack;
    ctx.fillRect(x, y, w, h);
    ctx.fillStyle = color;
    ctx.fillRect(x, y, w * r, h);
  }
}

// ──────────────────────────────────────────────────────────
// 颜色小工具
// ──────────────────────────────────────────────────────────

/** #rrggbb 加透明度 → rgba() */
function hexA(hex: string, a: number): string {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16);
  const g = parseInt(h.slice(2, 4), 16);
  const b = parseInt(h.slice(4, 6), 16);
  return `rgba(${r},${g},${b},${a})`;
}

/** 变亮（amt > 0）或变暗（amt < 0） */
function lighten(hex: string, amt: number): string {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16);
  const g = parseInt(h.slice(2, 4), 16);
  const b = parseInt(h.slice(4, 6), 16);
  const f = (v: number): number =>
    Math.max(0, Math.min(255, Math.round(amt >= 0 ? v + (255 - v) * amt : v * (1 + amt))));
  return `rgb(${f(r)},${f(g)},${f(b)})`;
}

function turbidText(t: TurbidState): string {
  const v = Math.round(t.value);
  if (t.phase === 'corrupting') return `浊化！${t.phaseLeft.toFixed(1)}s`;
  if (t.phase === 'weak') return `虚弱 ${t.phaseLeft.toFixed(1)}s`;
  return `浊气 ${v} / ${Math.round(TURBID_MAX)}`;
}
