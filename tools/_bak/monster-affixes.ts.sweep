const AFFIX_BY_ID: ReadonlyMap<string, MonsterAffixDef> = new Map(
  MONSTER_AFFIX_DEFS.map((d) => [d.id, d]),
);

export function getMonsterAffix(id: string): MonsterAffixDef | undefined {
  return AFFIX_BY_ID.get(id);
}

export function isMonsterAffixId(value: unknown): value is string {
  return typeof value === 'string' && AFFIX_BY_ID.has(value);
}

/** 稀有度 → 妖纹条数区间（REQ §3 第 8 条：普通 0 / 魔法 1~2 / 稀有 3~4） */
export function affixCountRange(rarity: MonsterRarity): readonly [number, number] {
  if (rarity === 'magic') return [1, 2];
  if (rarity === 'rare') return [3, 4];
  return [0, 0];
}

/** 妖纹条数 → 稀有度（条数是唯一判据，避免两处各写一套边界） */
export function rarityOfAffixCount(count: number): MonsterRarity {
  if (!Number.isFinite(count) || count <= 0) return 'normal';
  if (count <= 2) return 'magic';
  return 'rare';
}

/** 一份妖纹的合计效果 */
export interface MonsterAffixSum {
  readonly damageInc: number;
  readonly lifeInc: number;
  readonly armorInc: number;
  readonly speedInc: number;
  readonly resistInc: number;
  readonly intervalMul: number;
  readonly dropBonus: number;
}

export const NO_AFFIX_SUM: MonsterAffixSum = {
  damageInc: 0,
  lifeInc: 0,
  armorInc: 0,
  speedInc: 0,
  resistInc: 0,
  intervalMul: 1,
  dropBonus: 0,
};

export function sumMonsterAffixes(ids: readonly string[] | undefined): MonsterAffixSum {
  if (!ids || ids.length === 0) return NO_AFFIX_SUM;
  let damageInc = 0;
  let lifeInc = 0;
  let armorInc = 0;
  let speedInc = 0;
  let resistInc = 0;
  let intervalMul = 1;
  let dropBonus = 0;
  for (const id of ids) {
    const def = AFFIX_BY_ID.get(id);
    if (!def) continue; // 未知 id 安静跳过：探针/旧档里可能带脏值
    damageInc += def.damageInc ?? 0;
    lifeInc += def.lifeInc ?? 0;
    armorInc += def.armorInc ?? 0;
    speedInc += def.speedInc ?? 0;
    resistInc += def.resistInc ?? 0;
    intervalMul *= def.intervalMul ?? 1;
    dropBonus += def.dropBonus;
  }
  return {
    damageInc,
    lifeInc,
    armorInc,
    speedInc,
    resistInc,
    intervalMul,
    dropBonus: Math.min(MONSTER_QTY_CAP, dropBonus),
  };
}

/** 妖纹名的展示串（「凶煞 · 厚皮 · +2」）；无妖纹返回空串 */
export function monsterAffixSuffix(ids: readonly string[] | undefined, maxNames = 2): string {
  if (!ids || ids.length === 0) return '';
  const names = ids.map((id) => AFFIX_BY_ID.get(id)?.name).filter((n): n is string => !!n);
  if (names.length === 0) return '';
  const shown = names.slice(0, maxNames);
  const rest = names.length - shown.length;
  return rest > 0 ? ` · ${shown.join('·')} +${rest}` : ` · ${shown.join('·')}`;
}
