/**
 * 怪物妖纹（= 怪物词缀，REQ §3 第 8 条 / D3 签的「妖怪词缀先做 8 条」）。
 *
 * 在此之前项目里**只有稀有度、没有妖纹**：`DROP_CHANCE` / `DROP_RARITY_BONUS`
 * 的 magic / rare 两档是死代码（`spawnRing` 从不传 rarity ⇒ 实战里除镇守全是 normal），
 * REQ §5 的验收判据「越精英越稀有的怪掉落好装备和通货的概率越大」只有镇守一个例外。
 *
 * ## 结构约束（shuzhi v4.44，比数值更重要）
 * **8 条妖纹分 4 类（伤害 / 防御 / 速度 / 经济），每类 2 条；一只怪最多 4 条，且「每类至多 1 条」。**
 * 这样「四条全叠伤害」在生成阶段就不可能发生 —— 不靠数值上限去堵洞，用结构防死。
 *
 * ## 数值口径
 * 伤害/防御/速度/抗性都是 **increased（加法汇总后乘一次）**，不是逐条相乘：
 * 4 条同类的乘法叠加会指数爆炸，而「+30% +45%」这种加法在 UI 上也能一句话说清。
 * `attackInterval` 是唯一的乘法（`×1.25` / `×0.80`），因为「出手间隔」天然是倍率。
 *
 * ## 掉落数量
 * `dropBonus` 是**数量**加成（累加后钳到 `MONSTER_QTY_CAP = 0.24`），语义是
 * 「这一杀多出来的那部分产出」：通货/玉简份额 ×(1+q)，法宝吃剩下的 `1 − 0.6(1+q)`。
 * ⚠️ 所以 dropBonus 给大了会**挤压法宝份额**（4 条 ×0.12 = 0.48 时法宝只剩 0.112，
 * rare 反而比 normal 穷）。这是 cap 压到 0.24 的唯一原因（shuzhi 的推导）。
 *
 * 纪律：妖纹倍率只作用于**个体**（在 `spawnMonster` 里算），绝不改 `BASE_MONSTER_HP` /
 * `FLOOR_HP_MUL` 这类全局常量 —— 否则整条层曲线一起漂，几轮验收基线全作废。
 *
 * ## 通道有效性（D97，血的教训：**词条写了不等于生效**）
 * 妖纹必须落在「玩家伤害真的会读」的通道上，否则是一条随机占位的死词条，而且**失效不报错**：
 * - ✅ 五行抗性（`resistInc`）：`mitigationOf` 里占 70% 权重 —— 前提是**这只怪有抗性表**；
 * - ⚠️ 护甲（`armorInc`）：只占 30% 权重，且玩家伤害全部带五行标签 ⇒ 护甲翻倍对元素 TTK
 *   只有 +0.6~2.8%（实测：`yaoshi-zhu` 层 5 火系 +2.8%、层 20 火系 +1.3%），
 *   15 只怪里还有 2 只 `armor === 0` 翻了还是 0 ⇒ **本项目里等于死通道**；
 * - ✅ 气血 / 伤害 / 出手间隔 / 移速 / 数量加成：都有真实消费者。
 * 由此立的不变量（有单测）：**每只怪至少有一条自己的五行抗性**，新加怪必须给。
 */

import type { MonsterRarity } from './monsters';

/** 妖纹的四个类别：同类互斥（一只怪每类至多 1 条） */
export type MonsterAffixCategory = 'damage' | 'defense' | 'speed' | 'economy';

export const MONSTER_AFFIX_CATEGORY_NAME: Readonly<Record<MonsterAffixCategory, string>> = {
  damage: '伤害',
  defense: '防御',
  speed: '速度',
  economy: '经济',
};

export interface MonsterAffixDef {
  readonly id: string;
  /** 妖纹名（两字，修仙味；显示在怪物血条右侧） */
  readonly name: string;
  readonly category: MonsterAffixCategory;
  readonly desc: string;
  /** 攻伐 increased（加法汇总） */
  readonly damageInc?: number;
  /** 气血 increased */
  readonly lifeInc?: number;
  /** 护体 increased */
  readonly armorInc?: number;
  /** 移速 increased */
  readonly speedInc?: number;
  /** 五行抗性 increased（各元素同比例） */
  readonly resistInc?: number;
  /** 出手间隔倍率（乘法；>1 = 出手更慢，<1 = 更快） */
  readonly intervalMul?: number;
  /** 掉落**数量**加成（累加后钳到 `MONSTER_QTY_CAP`） */
  readonly dropBonus: number;
  /**
   * 从第几层起进入掷档池（省略 = 1，即全层可用）。
   * D148：深层专属妖纹只在这个池子里，避免「层 1 的新手遇到 `磐`（气血 ×2.5）」。
   */
  readonly minFloor?: number;
}

/** 一只怪合计的数量加成上限（shuzhi 定稿；`LOOT_QUANTITY_CAP 0.58` 不动） */
export const MONSTER_QTY_CAP = 0.24;

/**
 * 深层专属妖纹的起始层（D148）。与 `threatMul` 的斜坡同段（层 22 起渐进门禁、
 * 层 28 起进精英池）—— 层 22~27 是「威胁变疼」，层 28+ 是「精英变硬」，两个梯度不重叠。
 */
export const DEEP_AFFIX_MIN_FLOOR = 28;

/** 某一层可用的妖纹池（层号脏值按第 1 层算） */
export function affixesForFloor(floor: number): readonly MonsterAffixDef[] {
  const f = Number.isFinite(floor) ? Math.max(1, Math.floor(floor)) : 1;
  return MONSTER_AFFIX_DEFS.filter((d) => f >= (d.minFloor ?? 1));
}

