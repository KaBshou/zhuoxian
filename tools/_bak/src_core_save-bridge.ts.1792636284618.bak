// ────────────────────────────────────────────────────────────
// session ↔ 存档桥（纯函数，不碰 localStorage）
// ────────────────────────────────────────────────────────────
//
// GameSession 是「运行中的一切」（含怪/浮字/日志等运行时态），
// SaveState 是「关页面后还活着的最小集合」。
// 这个文件只负责两件事：
//   sessionToSave(s)   —— 存的时候抽走持久态
//   sessionFromSave(st, tables) —— 读的时候重建运行时态
//
// 【重建约定】回来不是接着上一帧继续，而是「回到这一层的这一波开头」：
//   - 血满 / 真元满 / 浊气清零（放置游戏惯例：离线是闭关，不是续命）
//   - 场上没怪，第一帧 startWave 重新撒
//   - 战斗态（BattleState）整个重建 —— 它全是运行时态

import type { Item } from './item';
import type { Rng } from './rng';
import { Rng as RngClass } from './rng';
import type { ItemBaseDef } from '../data/bases';
import type { AffixDef } from '../data/affix-def';
import type { GameSession } from './session';
import { createSession, startWave } from './session';
import type { ClassId } from '../data/classes';
import type { SaveState } from './save';
import { serialize, SAVE_VERSION } from './save';
import type { CurrencyId } from '../data/currency';

/**
 * 从运行中的 session 抽出存档。
 * 调用方负责把返回值 JSON.stringify 进 localStorage（本文件不碰浏览器 API）。
 */
export function sessionToSave(s: GameSession): SaveState {
  return serialize({
    character: s.character,
    bag: s.bag,
    floor: s.floor,
    wave: s.wave,
    firstClearedFloors: s.firstClearedFloors,
    maxFloorReached: s.maxFloorReached,
    pocket: s.pocket,
    gemPouch: s.gemPouch,
    rngState: s.rng.state,
  });
}

export interface RestoreOptions {
  readonly tables: { bases: readonly ItemBaseDef[]; affixes: readonly AffixDef[] };
  /**
   * 离线秒数（savedAt 距现在的差）。
   * v1 不算离线收益（那是下一步），只把它带出来给调用方，职责分离。
   */
  readonly offlineSeconds?: number;
}

/**
 * 从存档重建一个可运行的 session。
 * rngState 回填 → 掉落序列接着存档那一刻继续，不会重摇。
 */
export function sessionFromSave(state: SaveState, opts: RestoreOptions): GameSession {
  const s = createSession({
    classId: state.player.classId as ClassId,
    seed: state.rngState.seed,
    tables: opts.tables,
    talentIds: state.player.talentIds,
  });
  // ---- 角色态回填（createSession 建的是新号，逐字段覆盖成存档值） ----
  const ch = s.character as { -readonly [K in keyof typeof s.character]: unknown };
  ch.step = state.player.step;
  ch.xp = state.player.xp;
  ch.ascendancyId = state.player.ascendancyId;
  ch.gemLoadouts = state.player.gemLoadouts ? { ...state.player.gemLoadouts } : undefined;
  ch.talentIds = state.player.talentIds ? [...state.player.talentIds] : undefined;
  ch.equipment = state.player.equipment;
  s.bag = [...state.player.bag];
  // ---- 进度 / 经济回填 ----
  s.floor = state.progress.floor;
  s.wave = state.progress.wave;
  (s as { firstClearedFloors: number[] }).firstClearedFloors = [...state.progress.firstClearedFloors];
  s.pocket = { ...state.economy.pocket };
  (s as { gemPouch: Record<string, number> }).gemPouch = { ...state.economy.gemPouch };
  // ---- rng 接续（防"刷新后掉落序列重演"） ----
  (s.rng as Rng).state = { ...state.rngState };
  // ---- 波号对位：startWave 会 wave+=1，所以恢复时先退一格，让 startWave 加回来 ----
  // 下界必须是 0 不是 1：存档 wave=1 时 1-1=0，startWave 加回 1；写成 1 会让每档多跳一波
  s.wave = Math.max(0, state.progress.wave - 1);
  // ---- 重建战斗态：满状态开局，从这一波重新打 ----
  s.battle = rebuildBattle(s);
  startWave(s);
  return s;
}

/** 存档有没有离线收益可领（savedAt 距今超过阈值才算"离线"） */
export const OFFLINE_MIN_SECONDS = 60;

export function offlineSecondsOf(state: SaveState, now = Date.now()): number {
  if (!state.savedAt) return 0;
  return Math.max(0, Math.floor((now - state.savedAt) / 1000));
}

// rebuildBattle 从 battle.ts 取，避免 session.ts 与 save 桥循环依赖
import { playerBattleFromCharacter, createBattle } from './battle';
import { switchOverridesFor } from './talents-runtime';

function rebuildBattle(s: GameSession) {
  const switches = switchOverridesFor(s.character.talentIds ?? []);
  return createBattle(playerBattleFromCharacter(s.character), s.character.turbid, s.character, switches);
}

// 显式导出，类型引用方不用绕路
export type { SaveState, CurrencyId, Item };
export { SAVE_VERSION };
